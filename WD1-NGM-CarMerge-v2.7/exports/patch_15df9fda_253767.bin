function export:Disable_Respawn() --added function to start respawn block timeout
  local l0
  self = self._graph
  --if not chased and not in mission
  if FelonyGetType(GetLocalPlayerEntityId()) == 8 and Globals._CUSTOM_SCRIPTS._In_Mission == 0 then
    self.Dialogue_Clear = {
      "0x000ebb2c", --"That's all of them."
      "0x000eb97f", --"Looks clear."
      "0x000eb9ba", --"That's everyone."
      "0x000ebbdc", --"They are done."
      "0x000ebb41", --"Got 'em all."
      "0x000ebc15", --"There's noone left."
      "0x000eb9c5", --"They are finished."
      "0x000ebc7c", --"All clear."
    }
    --playing dialogue
    l0 = self[999]
    l0.Entity = GetLocalPlayerEntityId()
    l0.SoundId = self.Dialogue_Clear[math.random(#self.Dialogue_Clear)]
    l0:Play()
  end
  Globals._CUSTOM_SCRIPTS._Guards_List[13] = { GetInvalidEntityId(), }
  Globals._CUSTOM_SCRIPTS._Respawn_Blocked[13] = Globals._CUSTOM_SCRIPTS._Respawn_Timeout
  CDominoManager_GetInstance():SpawnDominoEntity("Domino/User/windycity/Custom_Scripts/Restricted_Areas/17_madmile_cardealership.17_madmile_cardealership_persistent_timeout.lua")
  self:ShutDown()
  CDominoManager_GetInstance():RemoveDominoEntity(self.This_Script)
end
