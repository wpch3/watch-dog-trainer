function export:ShutDown()
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Startup_Check_Uncompleted
  l0:In()
  if Globals._CUSTOM_SCRIPTS._Respawn_Blocked[13] > 0 then
    self:StartTimer()
    l0 = self[100]
    l0:In()
  end
end
