function export:Reset_Layer()
  local l0
  self = self._graph
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  self.PlayerPawn = l0.PlayerID
  for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[13] do
    RemoveEntity(Globals._CUSTOM_SCRIPTS._Guards_List[13][i])
  end
  Globals._CUSTOM_SCRIPTS._Guards_List[13] = { GetInvalidEntityId(), }
  l0 = self[99]
  l0:ShutDown()
  l0 = self[0]
  l0.LayerName = self.MissionLayer
  l0:Unload()
  l0 = self[1]
  l0.LayerName = self.Layer
  l0:Reset()
end
