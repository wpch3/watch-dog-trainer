function export:Disable_Invasions()
  local l0
  self = self._graph
  --checking IF not other multiplayer mode AND zone mission layer not loaded AND not digital trips
  if GetNumberOfPlayers() == 1.000000 and GetEntityPosition("2080565488473230475", 2) == 0 and GetEntityPosition("2080711752735150797", 2) == 0 and GetEntityPosition("2082563707426260037", 2) == 0 and GetEntityPosition("2082371120201204534", 2) == 0 and GetEntityPosition("2081694354673681048", 2) == 0 and GetEntityPosition("2080282882919629347", 2) == 0 then
    if Globals._CUSTOM_SCRIPTS._In_Mission == 0 and Globals._CUSTOM_SCRIPTS._Gameplay_Context == 0 then
      Globals._CUSTOM_SCRIPTS._Gameplay_Context = 1
      SetDensityContextOverride("GameplayContextSpec.4012897103") --CUSTOM gameplaycontextspec.lib REQUIRED
      --AddScriptNarrativeDelay(9999)
	end
    l0 = self[0]
    l0.LayerName = self.MissionLayer
    l0:Load()
  end
end
function export:Start_Script()
  local l0
  self = self._graph
MissionAreaActivation(self.ForbiddenZone, 0)
