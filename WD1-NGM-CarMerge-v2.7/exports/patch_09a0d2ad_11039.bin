  self.ForbiddenZone = "2079957555276154924" --id of restricted area (used also as entity1 for proximity trigger in this case)
  self.Zone_Icon_Mission = "2079649621595914909" --entity1 for proximity trigger (unused in this case, using Red_Zone instead)
  self.Radius_Small = 20 --safety radius to avoid loading area if respawned inside it
  self.Radius_Medium = 60 --load radius when approaching hub
  self.Radius_Large = 80 --unload radius when leaving hub
  self.Main_Script = "Domino/User/windycity/Custom_Scripts/Restricted_Areas/17_madmile_cardealership.17_madmile_cardealership_persistent.lua" --path to real script
  self.Timer_Script = "Domino/User/windycity/Custom_Scripts/Restricted_Areas/17_madmile_cardealership.17_madmile_cardealership_persistent_timeout.lua" --path to timer script
  self[0] = cbox:CreateBox("Domino/System/MissionLayer_v2.lua")
