function export:Enable_Mutator()
  local l0
  self = self._graph
  --apply selected mutator
  if self.Mutator == 1 then
    PushTokenString("[#STRINGB]", "- GOD MODE")
    ActivateInvincibility(GetLocalPlayerEntityId())
    --setting appropriate enforcer properties
    SetPlayerMaxLocomotionSpeedTypeOverride(GetLocalPlayerEntityId(), 2)
    SetCoverAllowedOverride(GetLocalPlayerEntityId(), 0)
    SetCoverToCoverAllowedOverride(GetLocalPlayerEntityId(), 0)
  elseif self.Mutator == 2 then
    PushTokenString("[#STRINGB]", "- INSTAKILL")
	self.List_Health = {}
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      table.insert(self.List_Health, GetPawnHealthPercentage(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]))
    end
    l0 = self[16]
    l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
    l0:Enable() --Instant_Kill
  elseif self.Mutator == 3 then
    PushTokenString("[#STRINGB]", "- NO TIMER")
    l0 = self[9]
    self.Final_Time = self.Remaining_Time + l0.RemainingTime
    l0:Stop()
  elseif self.Mutator == 4 then
    PushTokenString("[#STRINGB]", "- EXPLOSIVE HEADS")
    l0 = self[17]
    l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
    l0:Enable() --Explosive_Head
  elseif self.Mutator == 5 then
    PushTokenString("[#STRINGB]", "- INFINITE AMMO")
    l0 = self[18]
    l0.Seconds = 0.5
    l0:Start() --Infinite_Ammo
  elseif self.Mutator == 6 then
    PushTokenString("[#STRINGB]", "- SWAPPER")
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.3651876853", 1) --frag grenade
    AddItem("Items.3651876853", 10)
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.1174431968", 1) --ctos scan
    AddItem("Items.1174431968", 10)
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.2840708499", 1) --ied
    AddItem("Items.2840708499", 10)
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.2987530112", 1) --proximity ied
    AddItem("Items.2987530112", 10)
    EquipItem("Items.2987530112") --proximity ied
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      AssignNPCOverrideConfig(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i], "NPCOverrideConfig.3530244141") --custom_NoCoversBlindGrenades
    end
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.1718884258", 1) --Weapon.ARPistol.DefaultPistol
    AgentDrawWeaponType(GetLocalPlayerEntityId(), 0)
    l0 = self[15]
    l0.Input = "fire_trigger_press"
    l0:Enable() --Swap_Places
    l0 = self[9]
    l0.Seconds = 20 + math.ceil(self.Zone_Spawn[self.Index_Location]/2)
    l0:Start()
    l0:Pause()
  elseif self.Mutator == 7 then
    PushTokenString("[#STRINGB]", "- SLOW MODE")
    OverrideAdrenalineDuration(GetLocalPlayerEntityId(), 999)
    SetAdrenalineDilationOverride(GetLocalPlayerEntityId(), 0.5)
    RefillAdrenaline(GetLocalPlayerEntityId())
    StartAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 1)
  elseif self.Mutator == 8 then
    PushTokenString("[#STRINGB]", "- HYPER SPEED")
    OverrideAdrenalineDuration(GetLocalPlayerEntityId(), 999)
    SetAdrenalineDilationOverride(GetLocalPlayerEntityId(), 1.5)
    RefillAdrenaline(GetLocalPlayerEntityId())
    StartAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 1)
    l0 = self[9]
    l0.Seconds = 20 + math.ceil(self.Zone_Spawn[self.Index_Location]/5)
    l0:Start()
    l0:Pause()
  elseif self.Mutator == 9 then
    PushTokenString("[#STRINGB]", "- FOCUS DISABLED")
    CancelAdrenalineDurationOverride(GetLocalPlayerEntityId())
    CancelAdrenalineDilationOverride(GetLocalPlayerEntityId())
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 1)
  elseif self.Mutator == 10 then
    PushTokenString("[#STRINGB]", "- ONE IN THE CHAMBER")
    ForceRemoveItem("Items.2468964847", 999) --pistol
    ForceRemoveItem("Items.2581069272", 999) --smg
    ForceRemoveItem("Items.2875309739", 999) --ar
    ForceRemoveItem("Items.3376957109", 999) --buckshot
    ForceRemoveItem("Items.114103786", 999) --sniper
    ForceRemoveItem("Items.1321691069", 999) --gl
    ModifyBulletsInClip(GetLocalPlayerEntityId(), 0, 1, 0)
    ModifyBulletsInClip(GetLocalPlayerEntityId(), 1, 1, 0)
    ModifyBulletsInClip(GetLocalPlayerEntityId(), 2, 1, 0)
    ModifyBulletsInClip(GetLocalPlayerEntityId(), 3, 1, 0)
    l0 = self[19]
    l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
    l0:Enable() --Give_Bullet
	self.List_Health = {}
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      table.insert(self.List_Health, GetPawnHealthPercentage(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]))
    end
    l0 = self[16]
    l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
    l0:Enable() --Instant_Kill
  else
    PushTokenString("[#STRINGB]", "")
  end
  --displaying message
  PushTokenString("[#STRINGA]", "Round "..string.format("%d",self.Rounds_Max-#self.List_Zones).."/"..string.format("%d",self.Rounds_Max))
  SendMissionChannelMessageToLocalPlayersId(Globals._CUSTOM_SCRIPTS._Mission_ID, "PlayerCentric", "15380", 10) --"[#STRINGA] [#STRINGB]"
end
function export:Instant_Kill()
  local l0
  self = self._graph
  l0 = self[16]
  self.Attacker = l0.Attacker
  if self.Attacker == GetLocalPlayerEntityId() then
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      if GetPawnHealthPercentage(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]) < self.List_Health[i] then
        SendDamageToEntity(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i], GetLocalPlayerEntityId(), 16, 999, 1)
      end
    end
  end
  self.List_Health = {}
  for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
    table.insert(self.List_Health, GetPawnHealthPercentage(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]))
  end
end
function export:Explosive_Head()
  local l0
  self = self._graph
  l0 = self[17]
  self.Victim = l0.Victim
  self.Attacker = l0.Attacker
  self.Hit_Locations = { "Spine2", "Pelvis", "L UpperArm", "L Hand", "R UpperArm", "R Hand", "Head", "L Calf", "L Foot", "R Calf", "R Foot", "L UpperArm", "L Forearm", "R UpperArm", "R Forearm", "Spine2" }
  self.HitLocation = self.Hit_Locations[l0.HitLocation] or "Spine1"
  if self.Victim ~= GetLocalPlayerEntityId() and self.Attacker == GetLocalPlayerEntityId() and self.HitLocation == "Head" then
    SendDamageToEntity(self.Victim, GetLocalPlayerEntityId(), 3, 999, 512)
    RemoveEntity(self.Spawned_IED)
	if GetEntityBonePosition(self.Victim, "Head", 0, 0) ~= nil and GetEntityBonePosition(self.Victim, "Head", 1, 0) ~= nil and GetEntityBonePosition(self.Victim, "Head", 2, 0) ~= nil then
      self.Spawned_IED = SpawnEntityFromArchetype("{2177A2A6-6310-43B5-9B2D-300D6F21BCE8}", GetEntityBonePosition(self.Victim, "Head", 0, 0), GetEntityBonePosition(self.Victim, "Head", 1, 0), GetEntityBonePosition(self.Victim, "Head", 2, 0), 0, 0, 0)
    else
      self.Spawned_IED = SpawnEntityFromArchetype("{2177A2A6-6310-43B5-9B2D-300D6F21BCE8}", GetEntityPosition(self.Victim, 0), GetEntityPosition(self.Victim, 1), GetEntityPosition(self.Victim, 2), 0, 0, 0)
    end
    ForceHackIngredient(self.Spawned_IED, GetLocalPlayerEntityId())
  end
end
function export:Infinite_Ammo()
  local l0
  self = self._graph
ModifyBulletsInClip(GetLocalPlayerEntityId(), 0, 999, 1)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 1, 999, 1)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 2, 999, 1)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 3, 999, 1)
  l0 = self[18]
  l0.Seconds = 0.5
  l0:Start() --Infinite_Ammo
end
function export:Swap_Places()
  local l0
  self = self._graph
  self.Teleport_Target = GetReticleHitEntity() or GetLocalPlayerEntityId()
  if string.find(GetEntityName(self.Teleport_Target), "AIClasses") and PlayerIsDoingAction(4) == 1 and GetDistance2D(self.Teleport_Target, self.Zone_Entity[self.Index_Location]) < self.Zone_Despawn[self.Index_Location] then
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    ForceExitCover(GetLocalPlayerEntityId())
	self.Position_Player = { GetEntityPosition(GetLocalPlayerEntityId(), 0), GetEntityPosition(GetLocalPlayerEntityId(), 1), GetEntityPosition(GetLocalPlayerEntityId(), 2) }
	self.Position_Enemy = { GetEntityPosition(self.Teleport_Target, 0), GetEntityPosition(self.Teleport_Target, 1), GetEntityPosition(self.Teleport_Target, 2) }
    RemoveEntity(self.PFX_Player)
    RemoveEntity(self.PFX_Enemy)
    self.PFX_Player = SpawnEntityFromArchetype("{CF4A5A94-CD3C-D8F9-BDA3-AA1523871B49}", self.Position_Player[1], self.Position_Player[2], self.Position_Player[3], 0, 0, 0)
    self.PFX_Enemy = SpawnEntityFromArchetype("{CF4A5A94-CD3C-D8F9-BDA3-AA1523871B49}", self.Position_Enemy[1], self.Position_Enemy[2], self.Position_Enemy[3], 0, 0, 0)
    SetEntityPosition(GetLocalPlayerEntityId(), self.Position_Enemy[1], self.Position_Enemy[2], self.Position_Enemy[3])
    SetEntityPosition(self.Teleport_Target, self.Position_Player[1], self.Position_Player[2], self.Position_Player[3])
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      SendAICmdBHVstateV2(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i], "Unaware", GetLocalPlayerEntityId(), 0, 0, 0)
    end
  end
end
function export:Give_Bullet()
  local l0
  self = self._graph
ModifyBulletsInClip(GetLocalPlayerEntityId(), 0, 0, 0)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 1, 0, 0)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 2, 0, 0)
ModifyBulletsInClip(GetLocalPlayerEntityId(), 3, 0, 0)
SetItem("Items.2468964847", 1) --pistol
SetItem("Items.2581069272", 1) --smg
SetItem("Items.2875309739", 1) --ar
SetItem("Items.3376957109", 1) --buckshot
SetItem("Items.114103786", 1) --sniper
SetItem("Items.1321691069", 1) --gl
end

function export:Disable_Mutator()
  local l0
  self = self._graph
  --disable selected mutator
  if self.Mutator == 1 then --GOD MODE
    RemoveInvincibility(GetLocalPlayerEntityId())
    --setting appropriate player properties
    ResetPlayerMaxLocomotionSpeedTypeOverride(GetLocalPlayerEntityId())
    ResetCoverAllowedOverride(GetLocalPlayerEntityId())
    ResetCoverToCoverAllowedOverride(GetLocalPlayerEntityId())
  elseif self.Mutator == 2 then --INSTAKILL
    l0 = self[16]
    l0:Disable()
  elseif self.Mutator == 3 then --NO TIMER
  elseif self.Mutator == 4 then --EXPLOSIVE HEADS
    l0 = self[17]
    l0:Disable()
  elseif self.Mutator == 5 then --INFINITE AMMO
    l0 = self[18]
    l0:Stop()
  elseif self.Mutator == 6 then --SWAPPER
    AgentDrawWeaponType(GetLocalPlayerEntityId(), -1)
    ForceRemoveItem("Items.1718884258", 2) --Weapon.ARPistol.DefaultPistol
    l0 = self[15]
    l0:Disable()
  elseif self.Mutator == 7 then --SLOW MODE
    CancelAdrenalineDurationOverride(GetLocalPlayerEntityId())
    CancelAdrenalineDilationOverride(GetLocalPlayerEntityId())
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 0)
  elseif self.Mutator == 8 then --HYPER SPEED
    CancelAdrenalineDurationOverride(GetLocalPlayerEntityId())
    CancelAdrenalineDilationOverride(GetLocalPlayerEntityId())
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 0)
  elseif self.Mutator == 9 then --FOCUS DISABLED
    CancelAdrenalineDurationOverride(GetLocalPlayerEntityId())
    CancelAdrenalineDilationOverride(GetLocalPlayerEntityId())
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 0)
  elseif self.Mutator == 10 then --ONE IN THE CHAMBER
    l0 = self[19]
    l0:Disable()
    l0 = self[16]
    l0:Disable()
  end
end
_compilerVersion = 4
