function export:ShutDown()
  RemoveEntity(self.Spawnpoint)
  RemoveEntity(self.Spawned_IED)
  RemoveEntity(self.PFX_Player)
  RemoveEntity(self.PFX_Enemy)
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  l0 = self[100]
  l0.Checkpoint = "CheckPoint_0"
  l0:In() --Checkpoint_Reached
end
function export:CheckPoint_0()
  local l0
  --teleporting player back to initial location if possible
  if Globals._CUSTOM_SCRIPTS._Kingslayer_Location ~= nil then
    Globals._CUSTOM_SCRIPTS._Respawn_Blocked[Globals._CUSTOM_SCRIPTS._Kingslayer_Location] = 3600
    RemoveEntity(self.Spawnpoint)
    self.Spawnpoint = SpawnEntityFromArchetype("{C551D92C-84E7-60ED-7168-27138DBECB0F}", self.Zone_Boss[Globals._CUSTOM_SCRIPTS._Kingslayer_Location][1], self.Zone_Boss[Globals._CUSTOM_SCRIPTS._Kingslayer_Location][2], self.Zone_Boss[Globals._CUSTOM_SCRIPTS._Kingslayer_Location][3], 0, 0, self.Zone_Boss[Globals._CUSTOM_SCRIPTS._Kingslayer_Location][4]) --Road.Decal.Road_Stains_01
    TeleportEntity(GetLocalPlayerEntityId(), self.Spawnpoint, 0, 0)
    Globals._CUSTOM_SCRIPTS._Kingslayer_Location = nil
  end
  l0 = self[101]
  l0.SkipPostFX = 0
  l0.SkipCameraAlign = 0
  l0:PostCinematic() --Loadingscreen_Removed
end
function export:Loadingscreen_Removed()
  local l0
  self = self._graph
--unlock Seaside Restaurant top floor door
SetDoorLockState("2082897962033374037", 0)
--unlock Racine top floor door
SetDoorLockState("2082897625031379011", 0)
  --checking if completed or reloaded
  if Globals._CUSTOM_SCRIPTS._Kingslayer_Reward ~= nil then
    Globals._CUSTOM_SCRIPTS._Kingslayer_Reward = nil
    --executing rewards
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.3066831865", 1) --SideMissionXP.Difficulty.Hard (1000xp)
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.478524244", 1) --SideMissionXP.MobTrap (100000$)
    Globals._CUSTOM_SCRIPTS._Save_Game = 1
  end
  --unloading the custom layer
  l0 = self[1000]
  l0.LayerName = self.Layer_Name
  l0:Unload()
  --aborting mission
  l0 = Boxes[PathID("Domino/System/MissionController_v2.lua")]
  l0.Mission = "MissionList.2949057808"
  l0._graph = self
  l0.Out = DummyFunction
  l0:Abort()
end
function export:Checkpoint_Reached()
  local l0
  self = self._graph
  --loading layer only if needed
  if GetEntityPosition(self.Reference_Entity, 2) ~= 0 then
    --skipping layer load
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Layer_Loaded
    l0:In()
  else
    --loading the custom layer
    l0 = self[1000]
    l0.LayerName = self.Layer_Name
    l0:Reset() --Layer_Loaded
  end
end
function export:Layer_Loaded()
  local l0
  self = self._graph
  math.randomseed(Globals._CUSTOM_SCRIPTS._Random_Seed+math.floor(GetGameTime())) --set the global variable as math seed
  math.random(); math.random(); math.random() --pop some random numbers before using them for real
--getting player entity id for next functions
self.PlayerPawn = GetLocalPlayerEntityId()
--disabling felony system and random events and online activities
FelonySystemEnable(0)
RandomEventSystemEnable(0)
GridMonitoringEnable(0)
--disabling reputation
EnableReputation(0)
--zeroing rewards
Globals._CUSTOM_SCRIPTS._Kingslayer_Reward = nil
--zeroing initial location
Globals._CUSTOM_SCRIPTS._Kingslayer_Location = nil
self.Index_Location = 0
  --checking initial location
  for i=1, #self.Zone_Entity do
    if GetDistance3D(self.Zone_Entity[i], GetLocalPlayerEntityId()) > 0 and GetDistance3D(self.Zone_Entity[i], GetLocalPlayerEntityId()) < self.Zone_Safety[i] then
      Globals._CUSTOM_SCRIPTS._Kingslayer_Location = i
      self.Index_Location = i
      break
    end
  end
  --blocking RAID if needed
  if self.Index_Location == 10 then
    Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior = 3600
  end
  --displaying start message
  l0 = self[0]
  l0.MessageType = "MissionStart"
  l0.MessageIcon = "iconVigilante"
  l0.OasisID_1 = {
    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Description",
    id = "185495" --"CONTRACT ACCEPTED"
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Name",
    id = "145005" --"STREET CLEANING"
  }
  l0.Duration = 5
  l0.Queue = 0
  l0:Display() --Zone_Check
  --enabling reinforcements call monitor
  l0 = self[35]
  l0:Enable() --Disable_Reinforcements
end
function export:Disable_Reinforcements()
  local l0
  self = self._graph
--disabling reinforcement calls
EnableReinforcements(self.Mission_ID, 0)
  --unregistering reinforcers
  for x=1, #Globals._CUSTOM_SCRIPTS._Guards_List do
    for y=1, #Globals._CUSTOM_SCRIPTS._Guards_List[x] do
      UnregisterReinforcer(Globals._CUSTOM_SCRIPTS._Guards_List[x][y])
    end
  end
end
function export:Zone_Check()
  local l0
  self = self._graph
  --if initial zone still populated
  if Globals._CUSTOM_SCRIPTS._Respawn_Blocked[self.Index_Location] == 0 and Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][1] ~= 0 then
    --enable mission area
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Perimeter_Enable
    l0:In()
    --displaying objective message
    l0 = self[3]
    l0.MessageType = "MissionUpdate"
    l0.MessageIcon = "iconVigilante"
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "24738"} --"Eliminate all enemies."
    l0.Duration = -1
    l0.Queue = 0
    l0:Display()
    --displaying enemy dots
    for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
      if IsDead(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]) ~= 1 then
        SetIconVisible(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i], 1)
      end
    end
    --start monitoring zone enemies
    l0 = self[12]
    l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
    l0.CheckNow = 1
    l0:Enable() --Enemy_Killed --Zone_Cleared
  else
    --continuing mission
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Zone_Clear
    l0:In()
  end
end

function export:Enemy_Killed()
  local l0
