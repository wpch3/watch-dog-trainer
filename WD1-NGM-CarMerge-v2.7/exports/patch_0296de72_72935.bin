function export:Create(cbox)
  cbox:RegisterGlobals("Domino/User/windycity/custom_scripts/custom_scripts.globals.lua")
  cbox:RegisterBox("Domino/System/CameraLockController.lua")
  cbox:RegisterBox("Domino/Library/common/CinematicPrep.CinematicPrep.lua")
  cbox:RegisterBox("Domino/Library/common/FixerCameras.SuccessFixerCamera_v2.lua")
