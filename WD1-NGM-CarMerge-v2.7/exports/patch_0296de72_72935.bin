  cbox:LoadResource("sndres0x0004e0e1", "CSoundResource") --"Ok, go! Now!"
  cbox:LoadResource("sndres0x000c9c1e", "CSoundResource") --"Now. Go."
  cbox:LoadResource("sndres0x000c9b11", "CSoundResource") --"Go. Quick."
end
