  l0.Disabled = DummyFunction
  l0.PropertiesUpdated = DummyFunction
  l0.Out = DummyFunction
  l0:Enable()
  --enabling zone radius
  l0 = self[85]
  l0.Entity1 = GetLocalPlayerEntityId()
  l0.Entity2 = self.Zone_Entity[self.Index_Location]
  l0.Radius = self.Zone_Despawn[self.Index_Location]
