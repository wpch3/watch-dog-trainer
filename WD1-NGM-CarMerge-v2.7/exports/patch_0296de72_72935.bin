function export:Camera_B_Exiting()
  local l0
  self = self._graph
--placing target entity in front of player
self.Coordinate_X = self.Zone_Coordinates[1] + 10 * math.cos(math.rad(self.Zone_Coordinates[4] + 90))
self.Coordinate_Y = self.Zone_Coordinates[2] + 10 * math.sin(math.rad(self.Zone_Coordinates[4] + 90))
self.Coordinate_Z = self.Zone_Coordinates[3] + 1
UnBind(self.Reference_Entity)
SetEntityPosition(self.Reference_Entity, self.Coordinate_X, self.Coordinate_Y, self.Coordinate_Z)
  --look at target entity
  l0 = self[30]
  l0.Player = GetLocalPlayerEntityId()
  l0.BlendInTime = 0.5
  l0.BlendOutTime = 0.5
  l0.Target = self.Reference_Entity
  l0.Duration = 1.5
  l0.KillLockOnSpeed = 1
  l0.KillLockOnInput = 1
  l0:Start()
--forcing camera exit
ForceUserOutOfCamera(GetLocalPlayerEntityId())
end
