SetEntityPosition(self.Circle_Outer, GetEntityPosition(self.Zone_Entity[self.Index_Location], 0), GetEntityPosition(self.Zone_Entity[self.Index_Location], 1), GetEntityPosition(self.Zone_Entity[self.Index_Location], 2))
