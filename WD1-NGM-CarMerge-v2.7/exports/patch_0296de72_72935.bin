function export:Abort_Mission()
  local l0
  self = self._graph
--reenabling felony system and random events and online activities
FelonySystemEnable(1)
RandomEventSystemEnable(1)
GridMonitoringEnable(1)
--enabling reputation
EnableReputation(1)
  --disable mission area
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Perimeter_Disable
  l0:In()
  --disable cinematic mode
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Cinematic_Disable
  l0:In()
  --disabling reinforcements call monitor
  l0 = self[35]
  l0:Disable()
--aborting mission
LoadLastCheckpoint()
end


function export:Cinematic_Enable()
  local l0
  self = self._graph
  --disabling player detection
  SetOverrideCanDetectPlayer(0)
  --enabling invincibility
  ActivateInvincibility(GetLocalPlayerEntityId())
  --disabling controls
  PopPlayerActionMap(self.ActionMap)
  self.ActionMap = "cinematic_nocameralock"
  PushPlayerActionMap(self.ActionMap)
  --hiding UI
  EnableDisplay("Adrenaline", 0)
  EnableDisplay("Battery", 0)
  EnableDisplay("Camera", 0)
  EnableDisplay("Consommable", 0)
  EnableDisplay("DynamicContent", 0)
  EnableDisplay("DistrictMonitoring", 0)
  EnableDisplay("Felony", 0)
  EnableDisplay("Marker", 0)
EnableDisplay("MessageBox", 1)
  EnableDisplay("Minimap", 0)
  EnableDisplay("MonitoringLevel", 0)
  EnableDisplay("Profiler", 0)
  EnableDisplay("Reticle", 0)
  EnableDisplay("SoftwareLink", 0)
  EnableDisplay("Tags", 0)
  EnableDisplay("Wheel", 0)
RemoveAllStanceControlHelper()
  --setting scripted slowmotion
  OverrideAdrenalineDuration(GetLocalPlayerEntityId(), 999)
  SetAdrenalineDilationOverride(GetLocalPlayerEntityId(), 0.15)
  RefillAdrenaline(GetLocalPlayerEntityId())
  StartAdrenaline(GetLocalPlayerEntityId())
  SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 1)
end
function export:Cinematic_Disable()
  local l0
  self = self._graph
  --enabling player detection
  SetOverrideCanDetectPlayer(-1)
  --skipped if mutator GOD MODE
  if self.Mutator ~= 1 then
    --disabling invincibility
    RemoveInvincibility(GetLocalPlayerEntityId())
  end
  --enabling controls
  PopPlayerActionMap(self.ActionMap)
  self.ActionMap = "default_nopick" --requires custom inputactionmapcommon.xml
  PushPlayerActionMap(self.ActionMap)
  --displaying UI
  EnableDisplay("Adrenaline", 1)
  EnableDisplay("Battery", 1)
  EnableDisplay("Camera", 1)
  EnableDisplay("Consommable", 1)
  EnableDisplay("DynamicContent", 1)
  EnableDisplay("DistrictMonitoring", 1)
  EnableDisplay("Felony", 1)
  EnableDisplay("Marker", 1)
  EnableDisplay("MessageBox", 1)
  EnableDisplay("Minimap", 1)
  EnableDisplay("MonitoringLevel", 1)
  EnableDisplay("Profiler", 1)
  EnableDisplay("Reticle", 1)
  EnableDisplay("SoftwareLink", 1)
  EnableDisplay("Tags", 1)
  EnableDisplay("Wheel", 1)
  --skipped if mutator SLOW MODE or HYPER SPEED or FOCUS DISABLED
  if self.Mutator ~= 7 and self.Mutator ~= 8 and self.Mutator ~= 9 then
    --restoring manual slowmotion
    CancelAdrenalineDurationOverride(GetLocalPlayerEntityId())
    CancelAdrenalineDilationOverride(GetLocalPlayerEntityId())
    StopAdrenaline(GetLocalPlayerEntityId())
    RefillAdrenaline(GetLocalPlayerEntityId())
    SetAdrenalineInputsBlocked(GetLocalPlayerEntityId(), 0)
  else
    EnableDisplay("Adrenaline", 0)
  end
end


