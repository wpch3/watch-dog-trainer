    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Description",
    id = "196202" --"Next Round"
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Name",
    id = "145005" --"STREET CLEANING"
  }
  l0.Duration = 5
  l0.Queue = 0
  l0:Display() --Display_Objective
end
function export:Display_Objective()
  local l0
  self = self._graph
  --displaying enemy dots
  for i=1, #Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location] do
    if IsDead(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i]) ~= 1 then
      SetIconVisible(Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location][i], 1)
    end
  end
  --start monitoring zone enemies
  l0 = self[10]
  l0.PawnList = Globals._CUSTOM_SCRIPTS._Guards_List[self.Index_Location]
  l0.CheckNow = 1
  l0:Enable()
--SWITCHING INVENTORY
self.Switched_Inventory = 1
CScriptCallbackSystem_GetInstance():RemoveCallback(GetLocalPlayerEntityId(), Globals._CUSTOM_SCRIPTS._Inventory_callID)
SwitchLocalPlayerInventoryToEmpty()
ForceRemoveItem("Items.2803193695", 2) --Weapon.Pistols.D50.07_People
ForceRemoveItem("Items.3968788573", 2) --Weapon.Pistols.357REX.357REX_MP
--removing all ammo
ForceRemoveItem("Items.2468964847", 999) --pistol
ForceRemoveItem("Items.2581069272", 999) --smg
ForceRemoveItem("Items.2875309739", 999) --ar
ForceRemoveItem("Items.3376957109", 999) --buckshot
ForceRemoveItem("Items.114103786", 999) --sniper
ForceRemoveItem("Items.1321691069", 999) --gl
  --skipped if mutator SWAPPER
  if self.Mutator ~= 6 then
    --selecting secondary weapon types depending on zones
    self.Zone_Secondary = { 1, 1, 1, 2, 1, 1, 1, 2, 1, 2, 1, 1, 1, 2, 1, 2, 2, 1, 1, }
    repeat
      self.Secondary_Type = 2 + self.Zone_Secondary[self.Index_Location]*math.random(0,1)
    until #self.List_All[self.Secondary_Type] > 1
    --generating new random index from list
    self.Index_Primary = math.random(2,#self.List_All[1])
    self.Index_Secondary = math.random(2,#self.List_All[self.Secondary_Type])
    self.Weapon_Primary = self.List_All[1][self.Index_Primary]
    self.Weapon_Secondary = self.List_All[self.Secondary_Type][self.Index_Secondary]
    --adding weapons found at that random position
    ExecuteReward_V2(GetLocalPlayerEntityId(), self.Weapon_Primary, 1) --primary
    ExecuteReward_V2(GetLocalPlayerEntityId(), self.Weapon_Secondary, 1) --secondary
    --removing those weapons from list
    if #self.List_All[1] > 2 then
      table.remove(self.List_All[1], self.Index_Primary)
    end
    if #self.List_All[2] + #self.List_All[3] + #self.List_All[4] > 4 then
      table.remove(self.List_All[self.Secondary_Type], self.Index_Secondary)
    end
    --adding appropriate ammo
    SetItem("Items.2468964847", 60) --pistol
    SetItem("Items.2581069272", 90) --smg
    if self.Secondary_Type == 2 then
      SetItem("Items.2875309739", 90) --ar
    elseif self.Secondary_Type == 3 then
      SetItem("Items.3376957109", 40) --buckshot
    else
      SetItem("Items.114103786", 20) --sniper
      SetItem("Items.1321691069", 5) --gl
    end
    --drawing weapon
    AgentDrawWeaponType(GetLocalPlayerEntityId(), self.Secondary_Type-1)
  end
  --displaying time
  l0 = self[9]
  l0.Seconds = 20 + math.ceil(self.Zone_Spawn[self.Index_Location]/10)
  l0:Start()
  l0:Pause()
  --enable random mutator
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Enable_Mutator
  l0:In()
  --displaying objective message
  l0 = self[4]
  l0.MessageType = "MissionUpdate"
  l0.MessageIcon = "iconVigilante"
  if self.Index_Faction == 1 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "24738"} --"Eliminate all enemies."
  elseif self.Index_Faction == 2 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "24738"} --"Eliminate all enemies."
  elseif self.Index_Faction == 3 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "146637"} --"Eliminate all fixers."
  elseif self.Index_Faction == 4 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "105304"} --"Eliminate the militia."
  else
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "227282"} --"Eliminate all guards."
  end
  l0.Duration = 5
  l0.Queue = 0
  l0:Display() --Stage_Started
end
