  l0:Resume()
end


function export:One_Dead()
  local l0
  self = self._graph
  l0 = self[10]
  self.Victim = l0.Victim
  self.Attacker = l0.Attacker
  self.TakeDown = l0.TakeDown
  self.Hit_Locations = { "Spine2", "Pelvis", "L UpperArm", "L Hand", "R UpperArm", "R Hand", "Head", "L Calf", "L Foot", "R Calf", "R Foot", "L UpperArm", "L Forearm", "R UpperArm", "R Forearm", "Spine2" }
  self.HitLocation = self.Hit_Locations[l0.HitLocation] or "Spine1"
  self.Reasons = { ["$#2873080202"] = "Bullet Impact", ["$#1509070927"] = "Generic", ["$#1905746204"] = "Explosion", ["$#461431942"] = "Vehicle", ["$#724099965"] = "Takedown", ["$#1472391658"] = "Falling", ["$#4294967295"] = "None" }
  self.Reason = self.Reasons[l0.Reason] or "Generic"
--hiding enemy dot
SetIconVisible(self.Victim, 0)
  --selecting bonus time
  if self.TakeDown == 1 or self.HitLocation == "Head" or self.Reason == "Explosion" or self.Mutator == 8 then
    self.Bonus_Time = 10
  else
    self.Bonus_Time = 5
  end
  --retrieving remaining time
  l0 = self[9]
  l0:GetTime()
end
function export:Got_Time()
  local l0
  self = self._graph
  l0 = self[9]
  self.Remaining_Time = l0.RemainingTime + self.Bonus_Time
  --skipped if mutator NO TIMER
  if self.Mutator ~= 3 then
    --restarting countdown
    l0 = self[9]
    l0.Seconds = self.Remaining_Time
    l0:Start()
  end
  --playing bonus sound
  l0 = self[13]
  l0.SoundId = "0x000f88e4"
  l0:Play()
end

function export:All_Dead()
  local l0
  self = self._graph
  --stop monitoring zone enemies
  l0 = self[10]
  self.Victim = l0.Victim
  self.Attacker = l0.Attacker
  self.TakeDown = l0.TakeDown
  self.Hit_Locations = { "Spine2", "Pelvis", "L UpperArm", "L Hand", "R UpperArm", "R Hand", "Head", "L Calf", "L Foot", "R Calf", "R Foot", "L UpperArm", "L Forearm", "R UpperArm", "R Forearm", "Spine2" }
  self.HitLocation = self.Hit_Locations[l0.HitLocation] or "Spine1"
  self.Reasons = { ["$#2873080202"] = "Bullet Impact", ["$#1509070927"] = "Generic", ["$#1905746204"] = "Explosion", ["$#461431942"] = "Vehicle", ["$#724099965"] = "Takedown", ["$#1472391658"] = "Falling", ["$#4294967295"] = "None" }
  self.Reason = self.Reasons[l0.Reason] or "Generic"
  l0:Disable()
  --pausing countdown
  l0 = self[9]
  l0:Pause()
  --disable mission area
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Perimeter_Disable
  l0:In()
  --disable random mutator
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Disable_Mutator
  l0:In()
  --enable cinematic mode
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Cinematic_Enable
  l0:In()
  --if not takedown and not roadkill
  if self.TakeDown ~= 1 and GetCurrentSeat(GetLocalPlayerEntityId()) == 0 then
    --start look at last killed
    UnBind(self.Reference_Entity)
    Bind(self.Victim, self.Reference_Entity, self.HitLocation, 1)
    l0 = self[30]
    l0.Player = GetLocalPlayerEntityId()
    l0.BlendInTime = 0.5
    l0.BlendOutTime = 0.5
    l0.Target = self.Reference_Entity
    l0.Duration = 1.0
    l0.KillLockOnSpeed = 0
    l0.KillLockOnInput = 0
    l0:Start()
    --if player was aiming (doesn't work from cover)
	if PlayerIsDoingAction(4) == 1 and self.Reason ~= "Explosion" then
      --refilling weapon magazine
      ModifyBulletsInClip(GetLocalPlayerEntityId(), 0, 999, 1)
      ModifyBulletsInClip(GetLocalPlayerEntityId(), 1, 999, 1)
      ModifyBulletsInClip(GetLocalPlayerEntityId(), 2, 999, 1)
      ModifyBulletsInClip(GetLocalPlayerEntityId(), 3, 999, 1)
      --forcing aim
      SetForceAiming(GetLocalPlayerEntityId(), 3)
      --disabling controls
      PopPlayerActionMap(self.ActionMap)
	  self.ActionMap = "common_aiming_no_weapon_selection"
      PushPlayerActionMap(self.ActionMap)
	end
  end
--setting player vehicle indestructable
CDominoManager_GetInstance():SendRegisteredEventToEntity(GetCurrentVehicleEntityId(GetLocalPlayerEntityId()), "CVehicle_SetAsIndestructable")
  --displaying completed message
  l0 = self[5]
  l0.MessageType = "MissionUpdateCompleted"
  l0.MessageIcon = "iconVigilante"
  if self.Index_Faction == 1 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "24738"} --"Eliminate all enemies."
  elseif self.Index_Faction == 2 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "24738"} --"Eliminate all enemies."
  elseif self.Index_Faction == 3 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "146637"} --"Eliminate all fixers."
  elseif self.Index_Faction == 4 then
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "105304"} --"Eliminate the militia."
  else
    l0.OasisID_1 = {section = "HACKING.Interface Messages", item = "Eliminate", id = "227282"} --"Eliminate all guards."
  end
  l0.Duration = 5
  l0.Queue = 0
  l0:Display() --Stage_Completed
end
function export:Stage_Completed()
  local l0
  self = self._graph
  --stopping countdown
  l0 = self[9]
  self.Final_Time = self.Remaining_Time + l0.RemainingTime
  l0:Stop()
--stop aim
SetForceAiming(GetLocalPlayerEntityId(), 0)
--disabling controls
PopPlayerActionMap(self.ActionMap)
self.ActionMap = "cinematic_nocameralock"
PushPlayerActionMap(self.ActionMap)
--stopping slowmotion
StopAdrenaline(GetLocalPlayerEntityId())
RefillAdrenaline(GetLocalPlayerEntityId())
--increased respawn time
Globals._CUSTOM_SCRIPTS._Respawn_Blocked[self.Index_Location] = 3600
  --selecting next level
  if #self.List_Zones > 0 then
    --starting next level
    l0 = self[6]
    l0.MessageType = "MissionSuccess"
    l0.MessageIcon = "iconVigilante"
    l0.OasisID_1 = {
      section = "MISSIONS.COMMON.OBJECTIVES",
      item = "MISSIONSUCCESS",
      id = "165720" --"AREA CLEAN"
    }
    l0.OasisID_2 = {
      section = "MISSIONS.COMMON.OBJECTIVES",
      item = "MISSIONSUCCESS",
      id = "196202" --"Next Round"
    }
    l0.OasisID_3 = {
      section = "MISSIONS.SIDE.OBJECTIVES",
      item = "Description",
      id = "145005" --"STREET CLEANING"
    }
    l0.Duration = 5
    l0.Queue = 0
    l0:Display() --Start_Level
  else
    --marking rewards earned
    Globals._CUSTOM_SCRIPTS._Kingslayer_Reward = 1
    --completing mission
    l0 = self[7]
    l0.Camera = GetLocalPlayerEntityId()
    l0.Target = GetLocalPlayerEntityId()
    l0.MissionID = "MissionList.2949057808"
    l0.MissionTime = self.Final_Time
    l0.StopFelony = 0 --1 reenables felony system
    l0.OpenEnded = 1 --0 goes to blackscreen
    l0:Start() --Abort_Mission
  end
end


