  local l0
  self = self._graph
  --disabling camera monitor
  l0 = self[61]
  l0.PlayerEntity = GetLocalPlayerEntityId()
  l0.CameraEntity = self.Camera_B
  l0:Disable()
--resetting camera allignment
RealignCameraBehind(GetLocalPlayerEntityId())
--disabling grid shading
SetGridShading(0)
--enable profiler
SetProfilerAutoActivationInCamerasDisabled(GetLocalPlayerEntityId(), 0)
SetProfilerDisabled(GetLocalPlayerEntityId(), 0)
--enable tagging
SetTaggerComponentStatus(GetLocalPlayerEntityId(), 1)
--put away phone
RequestUseSoftware(GetLocalPlayerEntityId(), 0)
  --starting level
