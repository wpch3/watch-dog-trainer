function export:Create(cbox)
  cbox:RegisterBox("domino/user/windycity/custom_scripts/race/function_Race.lua")
  cbox:RegisterBox("Domino/Library/common/CinematicPrep.CinematicPrep.lua")
  cbox:RegisterBox("Domino/System/MissionCheckpointReach.lua")
end
function export:Init(cbox)
  local l0
  self[1] = cbox:CreateBox("domino/user/windycity/custom_scripts/race/function_Race.lua")
  l0 = self[1]
  l0._graph = self
  l0.Started = DummyFunction
  l0.Finished = DummyFunction
  l0.Stopped = DummyFunction
  self[100] = cbox:CreateBox("Domino/System/MissionCheckpointReach.lua")
  l0 = self[100]
  l0._graph = self
  l0.Out = self.Savegame_Reached
  l0.AllCheckpointsDisabled = DummyFunction
  self[101] = cbox:CreateBox("Domino/Library/common/CinematicPrep.CinematicPrep.lua")
  l0 = self[101]
  l0._graph = self
  l0.PreOut = DummyFunction
  l0.PostOut = self.Savegame_Reached
end
function export:ShutDown()
  local l0
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  math.randomseed(Globals._CUSTOM_SCRIPTS._Random_Seed+math.floor(GetGameTime())) --set the global variable as math seed
  math.random(); math.random(); math.random() --pop some random numbers before using them for real
  l0 = self[100]
  l0.Checkpoint = "CheckPoint_0"
  l0:In()
end
function export:CheckPoint_0()
  local l0
  self:Race()
  l0 = self[1]
  if type(l0.Grid_Position) == "table" then
    RemoveEntity(self.Spawnpoint)
    self.Spawnpoint = SpawnEntityFromArchetype("{C551D92C-84E7-60ED-7168-27138DBECB0F}", l0.Grid_Position[1], l0.Grid_Position[2], l0.Grid_Position[3], 0, 0, math.deg(l0.Grid_Position[4])) --Road.Decal.Road_Stains_01
    TeleportEntity(GetLocalPlayerEntityId(), self.Spawnpoint, 0, 0)
	l0.Grid_Position = nil
  end
  l0 = self[101]
  l0.SkipPostFX = 0
  l0.SkipCameraAlign = 0
  l0:PostCinematic()
end
function export:Savegame_Reached()
  local l0
  self = self._graph
  self:Race()
  l0 = self[1]
  l0:Start()
end
