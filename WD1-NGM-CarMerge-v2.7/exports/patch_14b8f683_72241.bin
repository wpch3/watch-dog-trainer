function export:ShutDown()
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  ShowMissionTextMessageLocalPlayer("MissionDebug", "DefaultIcon", "WRONG USAGE", "This script is meant to be used as a function.", "", "", 5, 0, self, "OnFinished", "OnDisplayed")
end
function export:Start()
  local l0
  math.randomseed(Globals._CUSTOM_SCRIPTS._Random_Seed+math.floor(GetGameTime())) --set the global variable as math seed
  math.random(); math.random(); math.random() --pop some random numbers before using them for real
--getting player entity id for next functions
self.PlayerPawn = GetLocalPlayerEntityId()
--disabling felony system
FelonySystemEnable(0)
--disabling reputation
EnableReputation(0)
  --loading custom layer
  l0 = self[1000]
  l0.LayerName = "custom_race"
  l0:Reset()
end
function export:Layer_Loaded()
  local l0
  self = self._graph
  --hide markers
  l0 = self[72]
  l0.MapPoint = self.Checkpoint_Normal
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Nitro
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Next
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Final
  l0:Hide()
  for i=1, #self.Marker_Enemy do
    l0.MapPoint = self.Marker_Enemy[i]
    l0:Hide()
  end
  --using precalculated data
  self.Race_Vehicles = Globals._CUSTOM_SCRIPTS._Race[tonumber(string.sub(self.Layer_Name, -2))].Race_Vehicles
  self.Opponents_Amount = Globals._CUSTOM_SCRIPTS._Race[tonumber(string.sub(self.Layer_Name, -2))].Opponents_Amount
  self.Difficulty_Level = Globals._CUSTOM_SCRIPTS._Race[tonumber(string.sub(self.Layer_Name, -2))].Difficulty_Level
  --calculating difficulty if needed
  if self.Difficulty_Level == nil then
    if self.Opponents_Amount <= 2 then --if 1vs1 skip easiest
      self.Difficulty_Level = math.random(2,3)
    elseif self.Race_Vehicles == 7 then --if slow boat skip hardest
      self.Difficulty_Level = math.random(1,2)
    elseif self.Race_Vehicles > 3 then --if fast vehicles skip easiest
      self.Difficulty_Level = math.random(2,3)
    elseif self.Race_Vehicles < 3 then --if slow vehicles skip hardest
      self.Difficulty_Level = math.random(1,2)
    else
      self.Difficulty_Level = math.random(1,3)
    end
  end
  --setting appropriate data
  if self.Opponents_Amount <= 2 then --if 1vs1 skip boss
    self.Probability_Boss = 0
  end
  if self.Race_Vehicles >= #self.Vehicles_List-1 then
    self.Probability_Chase = 0
    self.Probability_Boss = 0
    self.BHV_Controller = self[17]
    self.Difficulty_Levels = self.Difficulty_Boats
  else
    self.BHV_Controller = self[16]
    self.Difficulty_Levels = self.Difficulty_Cars
  end
-- self.Mission_ID = self.Mission_ID or nil
-- self.Layer_Name = self.Layer_Name or nil
  self.Mission_Name = self.Mission_Name or "195681" --"Race"
  self.Mission_Type = self.Mission_Type or "194137" --"RACE"
  self.Race_Laps = self.Race_Laps or 1
-- self.Grid_Position = self.Grid_Position or nil
-- self.Race_Path = self.Race_Path or nil
  self.Opponents_Amount = self.Opponents_Amount or 2^math.random(1,3)-1
  self.Difficulty_Level = self.Difficulty_Level or math.random(1,3)
  self.Probability_Chase = self.Probability_Chase or 25
  self.Probability_Boss = self.Probability_Boss or 25
-- self.Checkpoints_Data = self.Checkpoints_Data or nil
  self.Narrow_Grid = self.Narrow_Grid or 0
  self.Race_Vehicles = self.Vehicles_List[self.Race_Vehicles] or self.Vehicles_List[math.random(1,#self.Vehicles_List-2)]
  --validating opponents amount
  if self.Opponents_Amount <= 2 then
    self.Opponents_Amount = 1
  elseif self.Opponents_Amount <= 5 or self.Narrow_Grid == 1 then
    self.Opponents_Amount = 3
  else
    self.Opponents_Amount = 7
  end
  --validating difficulty
  if self.Difficulty_Level < 1 then
    self.Difficulty_Level = 1
  elseif self.Difficulty_Level > 3 then
    self.Difficulty_Level = 3
  end
  --ensuring parameters valid
  if self.Mission_ID == nil or self.Layer_Name == nil or self.Grid_Position == nil or self.Race_Path == nil or type(self.Checkpoints_Data) ~= "table" then
    ShowMissionTextMessageLocalPlayer("MissionDebug", "DefaultIcon", "RACE START FAILED", "Missing or invalid parameters.", "", "", 5, 0, self, "OnFinished", "OnDisplayed")
    AbortMissionWithDbObj(self.Mission_ID)
  else
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Race_Started
    l0:In()
  end
end
function export:Race_Started()
  local l0
  self = self._graph
self:Started()
  --displaying start message
  l0 = self[0]
  l0.Title = {
    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Name",
    id = self.Mission_Type
  }
  l0.Text = {
    section = "MISSIONS.SIDE.OBJECTIVES.Mob_Traps.MobTraps",
    item = "Description",
    id = self.Mission_Name
  }
  l0.Duration = 5
  l0.Queue = 0
  l0:Display() --Start_Phonecall
end
function export:Start_Phonecall()
  local l0
  self = self._graph
  --displaying objective marker
SetEntityPosition(self.Objective_Marker, self.Grid_Position[1], self.Grid_Position[2], self.Grid_Position[3])
  l0 = self[71]
  l0.MapPoint = self.Objective_Marker
  l0.LocText = { id = "165448" } --"Reach"
  l0.LocMapMarkerTitle = { id = self.Mission_Type }
  l0.LocMapMarkerDescription = { self.Mission_Name }
  l0:Show()
  --playing initial phonecall
  l0 = self[14]
  l0.Caller = "Unknown"
  l0.HeaderText = {
    section = "POPUPS.Phone Calls",
    item = "IncomingFrom",
    id = "15198"
  }
  l0.LineText = {
    section = "POPUPS.Phone Calls",
    item = "UNKNOWN",
    id = "17590"
  }
  l0.SoundIDList = { self.Initial_Phonecall[math.random(#self.Initial_Phonecall)] }
  l0.RingToneType = "Incoming"
  if GetDistance3D(GetLocalPlayerEntityId(), self.Objective_Marker) > 20 then
    l0:StartCall()
  end
  --displaying objective message
  l0 = self[15]
  l0.MessageType = "MissionUpdate"
  l0.MessageIcon = "iconRace"
  l0.OasisID_1 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "196958" --"Reach the meeting location."
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "194137" --"RACE"
  }
  l0.Duration = -1
  l0:Display()
  --enabling objective radius
  l0 = self[18]
  l0.Entity1 = GetLocalPlayerEntityId()
  l0.Entity2 = self.Objective_Marker
  l0.Radius = 20
  l0.CheckDistance3D = 1
  l0.CheckNow = 1
  l0:Enable() --Reached_Start
end

function export:Reached_Start()
  local l0
  self = self._graph
  --stopping phonecall
StopDominoPlayingDialog(GetLocalPlayerEntityId())
  l0 = self[14]
  l0:StopCall()
  --hiding objective message
  l0 = self[15]
  l0.MessageType = "MissionUpdate"
  l0.MessageIcon = "iconRace"
  l0.OasisID_1 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "196958" --"Reach the meeting location."
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "194137" --"RACE"
  }
  l0.Duration = -1
  l0:Hide()
  --hiding objective marker
  l0 = self[71]
  l0:Hide()
  --disabling objective radius
  l0 = self[18]
  l0:Disable()
  --starting fadeout
  l0 = self[51]
  l0.SequenceName = "precinematic"
  l0:StartPostFX()
--unblocking controls
PopPlayerActionMap("cinematic")
end
function export:Faded_Out()
  local l0
  self = self._graph
  --starting blackscreen
  l0 = self[50]
  l0.SequenceName = "blackscreen_loop_nofade"
  l0:StartPostFX()
--blocking controls
PushPlayerActionMap("cinematic")
--returning projectiles
UnspawnReleasedProjectiles(1)
--hiding ui
SendShowOrHideAllUIEvent(0)
--instantly stopping player vehicle
ForcePawnsVehicleStopFunction(GetLocalPlayerEntityId())
  --loading vanilla layer
  l0 = self[10]
  l0.LayerName = self.Layer_Name
  l0:Reset() --Loaded_Race
end
function export:Loaded_Race()
  local l0
  self = self._graph
--clearing everything
TriggerInitialSpawn()
  --shuffling vehicles list
  for i=#self.Race_Vehicles, 2, -1 do
    local j = math.random(i)
    self.Race_Vehicles[i], self.Race_Vehicles[j] = self.Race_Vehicles[j], self.Race_Vehicles[i]
  end
--calculating grid
self.List_Opponent_Vehicles = {}
self.List_Opponent_Drivers = {}
self.Grid_Index = 1
self.Grid_Positions = {}
self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4]) * 3
self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4]) * 3
table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --2
self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4]) * 6
self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4]) * 6
table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --3
  if self.Narrow_Grid == 1 then
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(65.225)) * 7.159
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(65.225)) * 7.159
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --6
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(47.29)) * 8.846
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(47.29)) * 8.846
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --7
    table.insert(self.Grid_Positions, { self.Grid_Position[1], self.Grid_Position[2] }) --1
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4]) * 9
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4]) * 9
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --4
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(90)) * 6.5
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(90)) * 6.5
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --5
  else
    table.insert(self.Grid_Positions, { self.Grid_Position[1], self.Grid_Position[2] }) --1
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4]) * 9
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4]) * 9
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --4
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(90)) * 6.5
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(90)) * 6.5
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --5
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(65.225)) * 7.159
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(65.225)) * 7.159
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --6
    self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(47.29)) * 8.846
    self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(47.29)) * 8.846
    table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --7
  end
self.Coordinate_X = self.Grid_Position[1] + math.cos(self.Grid_Position[4] - math.rad(35.838)) * 11.102
self.Coordinate_Y = self.Grid_Position[2] + math.sin(self.Grid_Position[4] - math.rad(35.838)) * 11.102
table.insert(self.Grid_Positions, { self.Coordinate_X, self.Coordinate_Y }) --8
  --spawning opponents
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Spawn_Vehicle
  l0:In()
end
function export:Spawn_Vehicle()
  local l0
  self = self._graph
--selecting opponent vehicle
self.Opponent_Selected = self.Race_Vehicles[self.Grid_Index]
  --spawning enemy vehicle
SetEntityPosition(self.Opponent_Selected, self.Grid_Positions[self.Grid_Index][1], self.Grid_Positions[self.Grid_Index][2], self.Grid_Position[3])
SetEntityAngle(self.Opponent_Selected, 0, 0, math.ceil(math.deg(self.Grid_Position[4])))
  l0 = self[63]
  l0.VehicleSpawner = self.Opponent_Selected
  l0:Spawn()
end
function export:Spawn_Driver()
  local l0
  self = self._graph
  l0 = self[63]
  table.insert(self.List_Opponent_Vehicles, l0.SpawnedVehicle)
  --spawning driver
SetEntityPosition(self.Driver_Spawner, self.Grid_Positions[self.Grid_Index][1], self.Grid_Positions[self.Grid_Index][2], self.Grid_Position[3])
SetEntityAngle(self.Driver_Spawner, 0, 0, math.ceil(math.deg(self.Grid_Position[4])))
  l0 = self[25]
  l0.AIGenerator = self.Driver_Generator
  l0:Spawn()
end
function export:Assign_Vehicle()
  local l0
  self = self._graph
  l0 = self[25]
  table.insert(self.List_Opponent_Drivers, l0.SpawnedEntity)
--assigning driver to vehicle
AssignVehicleSeat(self.List_Opponent_Vehicles[#self.List_Opponent_Vehicles], self.List_Opponent_Drivers[#self.List_Opponent_Drivers], 1, 0, 1, 0)
  --checking if all spawned
  if self.Grid_Index < self.Opponents_Amount then
    self.Grid_Index = self.Grid_Index + 1
    --continuing opponents spawn
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Spawn_Vehicle
    l0:In()
  elseif GetCurrentSeat(GetLocalPlayerEntityId()) == 1 then
    self.Grid_Index = self.Grid_Index + 1
    --starting race
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Start_Race
    l0:In()
  else
    self.Grid_Index = self.Grid_Index + 1
    --selecting player vehicle
    self.Opponent_Selected = self.Race_Vehicles[self.Grid_Index]
    --spawning player vehicle
    SetEntityPosition(self.Opponent_Selected, self.Grid_Positions[self.Grid_Index][1], self.Grid_Positions[self.Grid_Index][2], self.Grid_Position[3])
    SetEntityAngle(self.Opponent_Selected, 0, 0, math.ceil(math.deg(self.Grid_Position[4])))
    l0 = self[64]
    l0.VehicleSpawner = self.Opponent_Selected
    l0:Spawn() --Spawned_Player_Vehicle
  end
end
function export:Spawned_Player_Vehicle()
  local l0
  self = self._graph
  l0 = self[64]
  self.Player_Vehicle = l0.SpawnedVehicle
--assigning player to vehicle
PutPlayerInVehicle(GetLocalPlayerEntityId(), self.Player_Vehicle)
  --starting race
  l0 = self[11]
  l0.Seconds = 0.5
  l0:Start() --Start_Race
end

function export:Start_Race()
  local l0
  self = self._graph
--instantly stopping player vehicle
ForcePawnsVehicleStopFunction(GetLocalPlayerEntityId())
--positioning player vehicle
SetEntityPosition(GetCurrentVehicleEntityId(GetLocalPlayerEntityId()), self.Grid_Positions[self.Grid_Index][1], self.Grid_Positions[self.Grid_Index][2], self.Grid_Position[3])
SetEntityAngle(GetCurrentVehicleEntityId(GetLocalPlayerEntityId()), 0, 0, math.ceil(math.deg(self.Grid_Position[4])))
  --enabling helicopter
  self.currentHour, self.currentMinute, self.currentSecond = CDynamicEnvironmentManager_GetInstance():GetScriptedTimeOfDay()
  if self.currentHour > 20 or self.currentHour < 5 then
    self.Helicopter_Enabled = 1
    SetEntityPosition(self.Vehicle_Helicopter, self.Grid_Position[1], self.Grid_Position[2], 160)
    SetEntityAngle(self.Vehicle_Helicopter, 0, 0, math.ceil(math.deg(self.Grid_Position[4])))
    StartHelicopterBhv(self.Vehicle_Helicopter, GetLocalPlayerEntityId(), GetLocalPlayerEntityId(), "HelicopterBhvSetup.1179921624") --AggressiveSearch.DriveMission_Follow_normal
    StartHelicopterBhv(self.Vehicle_Helicopter, GetLocalPlayerEntityId(), GetLocalPlayerEntityId(), "HelicopterBhvSetup.1179921625") --custom.Race
  end
--displaying race path
AddOrRemoveAdditionalPath(GetLocalPlayerId(), self.Race_Path, 1)
  --playing grid sequence
SetEntityPosition(self.Reference_Entity, GetEntityPosition(self.Race_Path, 0), GetEntityPosition(self.Race_Path, 1), GetEntityPosition(self.Race_Path, 2))
  l0 = self[97]
  if self.Race_Laps <= 1 then
    l0.EventSequence = self.Grid_Sequence[1]
  else
    l0.EventSequence = self.Grid_Sequence[2]
  end
  l0:Start() --Sequence_Finished
end
function export:Sequence_Finished()
  local l0
  self = self._graph
--hiding race path
AddOrRemoveAdditionalPath(GetLocalPlayerId(), self.Race_Path, 0)
  --stopping blackscreen
  l0 = self[50]
  l0.SequenceName = "blackscreen_loop_nofade"
  l0:StopPostFX()
  --starting fadein
  l0 = self[52]
  l0.SequenceName = "postcinematic"
  l0:StartPostFX()
end
function export:Faded_In()
  local l0
  self = self._graph
--blocking controls
PushPlayerActionMap("cinematic")
--empty inventory
SwitchLocalPlayerInventoryToEmpty()
ForceRemoveItem("Items.2803193695", 2) --Weapon.Pistols.D50.07_People
ForceRemoveItem("Items.3968788573", 2) --Weapon.Pistols.357REX.357REX_MP
  --allowing personal nitro if not boat race
  if GetItemCount(GetLocalPlayerEntityId(), "Items.3024689468") > 0 and self.Difficulty_Levels ~= self.Difficulty_Boats then
    SetItem("Items.3024689468", GetItemCount(GetLocalPlayerEntityId(), "Items.3024689468"))
    EquipItem("Items.3024689468")
  end
  --for all opponents
  for i=1, #self.List_Opponent_Drivers do
    --displaying custom icon
    UnBind(self.Marker_Enemy[i])
    Bind(self.List_Opponent_Drivers[i], self.Marker_Enemy[i], "", 1)
    SendMapPointControllerEvent(self.Marker_Enemy[i], 1)
    -- SetMapMarkerPopUpDataWithMissionId(self.Marker_Enemy[i], "228227", "217906", Globals._CUSTOM_SCRIPTS._Mission_ID)
    -- SetIconVisible(self.List_Opponent_Drivers[i], 0)
    SetIconVisible(self.List_Opponent_Vehicles[i], 0)
    --setting boats indestructable because AI too dumb
    if self.Difficulty_Levels == self.Difficulty_Boats then
      CDominoManager_GetInstance():SendRegisteredEventToEntity(self.List_Opponent_Vehicles[i], "CVehicle_SetAsIndestructable")
    end
    --executing opponents checkpoint function
    self.Opponent_Index = i
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Checkpoint_Reached_Opponent
    l0:In()
  end
  --displaying checkpoint
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Checkpoint_Reached
  l0:In()
--playing music
CMusicManager_GetInstance():PlayMusicFromLua(self.Music[math.random(#self.Music-1)], 0.5, GetInvalidEntityId(), 1)
--displaying ui
SendShowOrHideAllUIEvent(1)
--hiding Hide In Car prompt
RemoveAllStanceControlHelper()
  --start countdown
RaceCounterShowHud(1)
  l0 = self[12]
  l0.Seconds = 3.0
  l0:Start()
end
function export:Countdown_Finished()
  local l0
  self = self._graph
--unblocking controls
PopPlayerActionMap("cinematic")
  --for all opponents
  for i=1, #self.List_Opponent_Drivers do
    --enabling tagging
    IndicatorSetIsVisible(GetLocalPlayerId(), self.List_Opponent_Drivers[i], 1)
    -- IndicatorSetLocNameId(GetLocalPlayerId(), self.List_Opponent_Drivers[i], "212331") --"2XTheTap"
    IndicatorSetColor(GetLocalPlayerId(), self.List_Opponent_Drivers[i], 1.0, 0.0, 0.0)
    SetTargetTagEntity(GetLocalPlayerEntityId(), self.List_Opponent_Drivers[i], 1, 0)
    --disabling takedown hacks otherwise too easy
    DisableHackableIncredient(self.List_Opponent_Vehicles[i], 1, 1, 1, 0)
    --assigning race behaviour to opponents
    l0 = self.BHV_Controller
    l0.VehicleMaster = self.List_Opponent_Vehicles[i]
    l0.FloatingVehicle = l0.VehicleMaster
    l0.VehicleTarget = GetLocalPlayerEntityId()
    l0.Target = l0.VehicleTarget
    l0.PathOrPos = self.Race_Path
	if i%3 == 0 then
      self.Skill_Opponent[i] = self.Difficulty_Level+2
	elseif i == 7 then
      self.Skill_Opponent[i] = self.Difficulty_Level
    else
      self.Skill_Opponent[i] = self.Difficulty_Level+1
    end
    l0.Config = self.Difficulty_Levels[self.Skill_Opponent[i]]
    l0.StopAtEndPoint = 0
    l0:Start()
  end
  --probability of gang leader
  if math.random(100) < self.Probability_Boss then
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Activate_Boss
    l0:In()
  end
--displaying hud
DeliveryShowHud()
DeliveryInitVehicleCount(self.Race_Laps, 0)
UnregisterVehicleForDamageBarUpdate()
RegisterVehicleForDamageBarUpdate(self.Vehicle_Madness, 0, self.Rewards_Hud[1+3-self.Difficulty_Level], "Vehicle Damage")
--race start time
self.Start_Time = GetGameTime()
  --starting looping timer to check place
  l0 = self[111]
  l0.Seconds = 0.3
  l0:Start()
  --starting looping timer to check opponents
  l0 = self[1111]
  l0.Seconds = 0.2
  l0:Start()
end


function export:Activate_Boss()
  local l0
  self = self._graph
--disabling police chase
self.Probability_Chase = 0
  --displaying bonus objective
  l0 = self[19]
  l0.MessageType = "MissionUpdate"
  l0.MessageIcon = "iconRace"
  l0.OasisID_1 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "14050" --"Take out the vehicle."
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "196610" --"Bonus objective"
  }
  l0.Duration = -1
  l0:Display()
--selecting boss
self.Boss_Index = math.random(#self.List_Opponent_Vehicles)
--applying boss tag
IndicatorSetLocNameId(GetLocalPlayerId(), self.List_Opponent_Drivers[self.Boss_Index], "145879") --"Target"
  --enabling boss monitor
  l0 = self[27]
  l0.Vehicle = self.List_Opponent_Vehicles[self.Boss_Index]
  l0.Pawn = self.List_Opponent_Drivers[self.Boss_Index]
  l0.NoMoveTime = 10
  l0.CheckNow = 1
  l0:Enable() --Start_Chase
end
function export:Start_Chase()
  local l0
  self = self._graph
  --hiding bonus objective
  l0 = self[19]
  l0.MessageType = "MissionUpdateCompleted"
  l0.Duration = nil
  l0:Display()
  --disabling boss monitor
  l0 = self[27]
  l0:Disable()
  --setting appropriate faction
  self.Index_Faction = 3 --Fixers
  for i=1, #Globals._CUSTOM_SCRIPTS._Proximity_Zone do
    if math.sqrt((Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][1]-GetEntityPosition(GetLocalPlayerEntityId(),0))^2 + (Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][2]-GetEntityPosition(GetLocalPlayerEntityId(),1))^2) < Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][3] then
	  if Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][4] == "Pawnee" then
	    self.Index_Faction = 4 --Militia
	  elseif Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][4] == "MadMile" then
	    self.Index_Faction = 1 --Club
	  elseif Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][4] == "Wards" then
	    self.Index_Faction = 2 --Viceroys
	  end
	  break
    end
  end
--ensuring vehicle destroyed
CDominoManager_GetInstance():SendRegisteredEventToEntity(self.List_Opponent_Vehicles[self.Boss_Index], "CVehicle_SetEngineBroken")
--executing rewards
AddReputationIncident(GetLocalPlayerEntityId(), "ReputationIncidents.3021303297") --HeatReputation.Mission_MainMissionIncrease (+50)
ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.1267158093", 1) --Cash.HardContractGold.EasyGold (3000$)
--playing music
CMusicManager_GetInstance():PlayMusicFromLua(self.Music[#self.Music], 0.0, GetInvalidEntityId(), 1)
--starting felony chase
FelonyStartChaseObj(GetLocalPlayerEntityId(), self.Index_Faction, "ChaseLevelParameters.3910538489", "ChaseLevelParameters.2008434473", 1, 1) --MobChaseLevels.VeryHard --MobChaseLevels.VeryHard.Search.InfiniteSearch
  --starting felony monitor
  l0 = self[55]
  l0.CheckNow = 0
  l0:Start() --Status_Evaded
end
function export:Status_Evaded()
  local l0
  self = self._graph
--playing music
CMusicManager_GetInstance():PlayMusicFromLua(self.Music[math.random(#self.Music-1)], 1.5, GetInvalidEntityId(), 1)
end


