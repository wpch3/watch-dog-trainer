function export:Checkpoint_Reached_Opponent()
  local l0
  self = self._graph
  --disabling checkpoint radius
  l0 = self[self.Opponent_Index]
  l0:Disable()
  --checking lap
  if self.Race_Laps > 1 and self.Lap_Indexes[self.Opponent_Index] < self.Race_Laps and self.Checkpoint_Indexes[self.Opponent_Index] == #self.Checkpoints_Data then
    --increasing index
    self.Lap_Indexes[self.Opponent_Index] = self.Lap_Indexes[self.Opponent_Index] + 1
    --zeroing index
    self.Checkpoint_Indexes[self.Opponent_Index] = 0
  end
  --lowering or rising opponent skill
  l0 = self.BHV_Controller
  l0.VehicleMaster = self.List_Opponent_Vehicles[self.Opponent_Index]
  l0.FloatingVehicle = l0.VehicleMaster
  if self.Lap_Indexes[self.Opponent_Index] >= self.Lap_Index and self.Checkpoint_Indexes[self.Opponent_Index]-self.Checkpoint_Index > 2 and self.Skill_Opponent[self.Opponent_Index]-1 >= 1 then
    l0.Config = self.Difficulty_Levels[self.Skill_Opponent[self.Opponent_Index]-1]
    l0:Start()
  elseif self.Lap_Indexes[self.Opponent_Index] <= self.Lap_Index and self.Checkpoint_Indexes[self.Opponent_Index]-self.Checkpoint_Index < -2 and self.Skill_Opponent[self.Opponent_Index]+1 <= #self.Difficulty_Levels then
    l0.Config = self.Difficulty_Levels[self.Skill_Opponent[self.Opponent_Index]+1]
    l0:Start()
  end
  --checking if race finished
  if self.Checkpoint_Indexes[self.Opponent_Index] < #self.Checkpoints_Data then
    --increasing index
    self.Checkpoint_Indexes[self.Opponent_Index] = self.Checkpoint_Indexes[self.Opponent_Index] + 1
    --enabling checkpoint radius
    SetEntityPosition(self.Reference_Entities[self.Opponent_Index], self.Checkpoints_Data[self.Checkpoint_Indexes[self.Opponent_Index]][1], self.Checkpoints_Data[self.Checkpoint_Indexes[self.Opponent_Index]][2], self.Checkpoints_Data[self.Checkpoint_Indexes[self.Opponent_Index]][3])
    l0 = self[self.Opponent_Index]
    l0.Entity1 = self.List_Opponent_Vehicles[self.Opponent_Index]
    l0.Entity2 = self.Reference_Entities[self.Opponent_Index]
    l0.Radius = self.Checkpoints_Data[self.Checkpoint_Indexes[self.Opponent_Index]][4]
    l0.CheckNow = 1
    l0:Enable()
  elseif self.Checkpoint_Indexes[self.Opponent_Index] == #self.Checkpoints_Data then
    --increasing index anyway to ensure distance always 0 after opponent finished
    self.Checkpoint_Indexes[self.Opponent_Index] = self.Checkpoint_Indexes[self.Opponent_Index] + 1
    --disabling indestructability
    CDominoManager_GetInstance():SendRegisteredEventToEntity(self.List_Opponent_Vehicles[self.Opponent_Index], "CVehicle_SetAsDestructable")
    --assigning flee behaviour
    l0 = self.BHV_Controller
    l0.VehicleMaster = self.List_Opponent_Vehicles[self.Opponent_Index]
    l0.FloatingVehicle = l0.VehicleMaster
    l0.VehicleTarget = GetLocalPlayerEntityId()
    l0.Target = l0.VehicleTarget
    l0.PathOrPos = GetLocalPlayerEntityId()
    l0.Config = self.Difficulty_Levels[1]
    l0.StopAtEndPoint = 0
    l0:Start()
    --if boss finished
    if self.Opponent_Index == self.Boss_Index then
      --hiding bonus objective
      l0 = self[19]
      l0:Hide()
      --disabling boss monitor
      l0 = self[27]
      l0:Disable()
    end
    --playing FirstGone dialogue only once
    if self.ONCE ~= 1 then
      self.ONCE = 1
      l0 = self[98]
      l0.SoundId = self.Announcer_FirstGone[math.random(#self.Announcer_FirstGone)]
      l0.Supersede = 1
      l0.UseFacial = 0
      l0:Start()
    end
  end
end

function export:Checkpoint_Reached()
  local l0
  self = self._graph
  --hide markers
  l0 = self[72]
  l0.Text = string.format("%d",self.Checkpoint_Index+1).."/"..string.format("%d",#self.Checkpoints_Data)
  l0.MapPoint = self.Checkpoint_Normal
  l0:SetText()
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Nitro
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Next
  l0:Hide()
  l0.MapPoint = self.Checkpoint_Final
  l0:Hide()
  --clearing paths
  ClearGPS3DTarget(GetLocalPlayerId())
  --disabling checkpoint radius
  l0 = self[30]
  l0:Disable()
  --probability of police chase
  if math.random(100) < self.Probability_Chase and self.Checkpoint_Index == math.ceil(#self.Checkpoints_Data/3) and self.Lap_Index == math.ceil(self.Race_Laps/2) then
    --playing sound
    StartPortalHackingBar("168944", 0.1) --"AMBUSH"
    --playing music
    CMusicManager_GetInstance():PlayMusicFromLua(self.Music[#self.Music], 0.0, GetInvalidEntityId(), 1)
    --setting max heat
    FelonySetHeat(GetLocalPlayerEntityId(), 100)
    --starting custom felony chase
	self.Index_Faction = 0
    if self.Player_Place > 1 then
      FelonyStartChaseObj(GetLocalPlayerEntityId(), self.Index_Faction, "ChaseLevelParameters.756444240", "ChaseLevelParameters.258745063", 1, 1) --ChaseLevel.ChaseLevel3.A01D00_extendBudget --ChaseLevel.ChaseLevel3.Search.A04F02_SearchLVL03
    else
      FelonyStartChaseObj(GetLocalPlayerEntityId(), self.Index_Faction, "ChaseLevelParameters.4000759216", "ChaseLevelParameters.258745063", 1, 1) --ChaseLevel.ChaseLevel5.ChaseLevel5_Companion --ChaseLevel.ChaseLevel3.Search.A04F02_SearchLVL03
    end
    --starting felony monitor
    l0 = self[55]
    l0.CheckNow = 0
    l0:Start() --Status_Evaded
  end
  --checking lap
  if self.Race_Laps > 1 and self.Lap_Index < self.Race_Laps and self.Checkpoint_Index == #self.Checkpoints_Data then
    --zeroing index
    self.Checkpoint_Index = 0
    --updating hud
    DeliveryInitVehicleCount(self.Race_Laps, self.Lap_Index)
    --increasing index
    self.Lap_Index = self.Lap_Index + 1
    --playing laps dialogues
    if self.Lap_Index == self.Race_Laps then
      l0 = self[98]
      l0.SoundId = self.Announcer_FinalLap[math.random(#self.Announcer_FinalLap)]
      l0.Supersede = 1
      l0.UseFacial = 0
      l0:Start()
    elseif self.Lap_Index > 1 then
      l0 = self[98]
      l0.SoundId = self.Announcer_FirstLap[math.random(#self.Announcer_FirstLap)]
      l0.Supersede = 1
      l0.UseFacial = 0
      l0:Start()
    end
  end
  --checking if race finished
  if self.Checkpoint_Index < #self.Checkpoints_Data then
    --playing checkpoint sound
    if self.Checkpoint_Index > 0 or self.Lap_Index > 1 then
      l0 = self[13]
      l0.SoundId = "0x000deac8"
      l0:Play()
    end
    --displaying checkpoint time
    if self.Checkpoint_Index > 0 or self.Lap_Index > 1 then
      self.Player_Time = GetGameTime() - self.Start_Time
	  local minutes = string.format("%02d",math.floor(self.Player_Time/60))
	  local seconds = string.format("%02d",math.floor(self.Player_Time%60))
	  local decimals = string.format("%02d",math.floor(self.Player_Time%1*100))
      PushTokenString("[#VALUE]", minutes..":"..seconds.."."..decimals)
      SendMissionChannelMessageToLocalPlayersId(Globals._CUSTOM_SCRIPTS._Mission_ID, "PlayerCentric", "113029", 3) --"Time: [#VALUE]"
    end
    --give nitro if appropriate
    if self.Checkpoint_Index > 0 and self.Checkpoint_Selected == self.Checkpoint_Nitro then
      ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.3024689468", 1)
      EquipItem("Items.3024689468")
      RemoveAllStanceControlHelper()
      AddStanceControlHelper("197983", "Normal", 10) --"Press [NITRO] to activate Nitro."
    end
    --increasing index
    self.Checkpoint_Index = self.Checkpoint_Index + 1
    --selecting next checkpoint type
    if self.Checkpoint_Index >= #self.Checkpoints_Data then
      self.Checkpoint_Selected = self.Checkpoint_Normal
      if self.Lap_Index >= self.Race_Laps then
        self.Checkpoint_Selected = self.Checkpoint_Final
	    self.Checkpoint_Text = "Finish"
      elseif self.Lap_Index+1 == self.Race_Laps then
	    self.Checkpoint_Text = "Final Lap"
      elseif self.Lap_Index+1 == 2 then
	    self.Checkpoint_Text = "Second Lap"
      elseif self.Lap_Index+1 == 3 then
	    self.Checkpoint_Text = "Third Lap"
      else
	    self.Checkpoint_Text = string.format("%d",self.Lap_Index+1).."th Lap"
      end
    elseif self.Checkpoints_Data[self.Checkpoint_Index][5] == 1 and self.Player_Place > 1 and self.Difficulty_Levels ~= self.Difficulty_Boats then --nitro checkpoint only if not already 1st place and not boat race
      self.Checkpoint_Selected = self.Checkpoint_Nitro
	  self.Checkpoint_Text = "Nitro"
    else
      self.Checkpoint_Selected = self.Checkpoint_Normal
	  self.Checkpoint_Text = string.format("%d",self.Checkpoint_Index).."/"..string.format("%d",#self.Checkpoints_Data)
    end
    --show current marker
    SetEntityPosition(self.Checkpoint_Selected, self.Checkpoints_Data[self.Checkpoint_Index][1], self.Checkpoints_Data[self.Checkpoint_Index][2], self.Checkpoints_Data[self.Checkpoint_Index][3])
    SetGPS3DTarget(GetLocalPlayerId(), self.Checkpoint_Selected)
    l0 = self[72]
    l0.MapPoint = self.Checkpoint_Selected
    l0.Text = self.Checkpoint_Text
    l0.LocMapMarkerTitle = { id = "195681" } --"Race"
    l0.LocMapMarkerDescription = { id = "178371" } --"CHECKPOINT"
    l0:Show()
    --show next marker
    if self.Checkpoint_Index < #self.Checkpoints_Data then
      SetEntityPosition(self.Checkpoint_Next, self.Checkpoints_Data[self.Checkpoint_Index+1][1], self.Checkpoints_Data[self.Checkpoint_Index+1][2], self.Checkpoints_Data[self.Checkpoint_Index+1][3])
      AddTarget(GetLocalPlayerId(), self.Checkpoint_Next, 1)
      l0 = self[72]
      l0.MapPoint = self.Checkpoint_Next
      l0.Text = "" --no text
      l0.LocMapMarkerTitle = { id = "195681" } --"Race"
      l0.LocMapMarkerDescription = { id = "178371" } --"CHECKPOINT"
      l0:Show()
      IndicatorSetIsVisible(GetLocalPlayerId(), self.Checkpoint_Next, 0)
    end
    --enabling checkpoint radius
    l0 = self[30]
    l0.Entity1 = GetLocalPlayerEntityId()
    l0.Entity2 = self.Checkpoint_Selected
    l0.Radius = self.Checkpoints_Data[self.Checkpoint_Index][4]
    l0.CheckNow = 1
    l0:Enable() --Checkpoint_Reached
  else
    --mission completed
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Mission_Completed
    l0:In()
  end
  --hide gps path during boat races
  if self.Difficulty_Levels == self.Difficulty_Boats then
    ClearGPS3DTarget(GetLocalPlayerId())
  end
end


function export:Mission_Completed()
  local l0
  self = self._graph
  --stopping looping timer
  l0 = self[111]
  l0:Stop()
  --stopping looping timer
  l0 = self[1111]
  l0:Stop()
  --hiding position
  l0 = self[20]
  l0:Hide()
  --hiding bonus objective
  l0 = self[19]
  l0:Hide()
  --disabling boss monitor
  l0 = self[27]
  l0:Disable()
  --stopping felony monitor
  l0 = self[55]
  l0:Stop()
--hiding hud
DeliveryVehicleDelivered()
  --for all opponents
  for i=1, #self.List_Opponent_Drivers do
    --hiding markers
    SendMapPointControllerEvent(self.Marker_Enemy[i], 0)
    IndicatorSetIsVisible(GetLocalPlayerId(), self.List_Opponent_Drivers[i], 0)
    ForceHideTagIndicator(self.List_Opponent_Drivers[i], 1)
    ForceHideTagIndicator(self.List_Opponent_Vehicles[i], 1)
    --disabling checkpoint radius
    l0 = self[i]
    l0:Disable()
    --assigning flee behaviour
    l0 = self.BHV_Controller
    l0.VehicleMaster = self.List_Opponent_Vehicles[i]
    l0.FloatingVehicle = l0.VehicleMaster
    l0.VehicleTarget = GetLocalPlayerEntityId()
    l0.Target = l0.VehicleTarget
    l0.PathOrPos = GetLocalPlayerEntityId()
    l0.Config = self.Difficulty_Levels[#self.Difficulty_Levels]
    l0.StopAtEndPoint = 0
    l0:Start()
  end
  --displaying success message
  l0 = self[40]
  l0.MessageType = "MissionSuccess"
  l0.MessageIcon = "iconRace"
  l0.OasisID_1 = {
    section = "MISSIONS.COMMON.OBJECTIVES",
    item = "MISSIONSUCCESS",
    id = "14104" --"Race Finished"
  }
  l0.OasisID_2 = {
    section = "MISSIONS.COMMON.OBJECTIVES",
    item = "MISSIONSUCCESS",
    id = self.Loc_Places[self.Player_Place]
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = self.Mission_Name
  }
  l0.Duration = 10
  l0.Queue = 0
  l0:Display()
--fading out music
CMusicManager_GetInstance():StopMusicFromLua(10.0)
--restoring player inventory
SwitchLocalPlayerInventoryToNormal()
  --giving appropriate rewards
  self.Player_Time = GetGameTime() - self.Start_Time
  local minutes = string.format("%02d",math.floor(self.Player_Time/60))
  local seconds = string.format("%02d",math.floor(self.Player_Time%60))
  local decimals = string.format("%02d",math.floor(self.Player_Time%1*100))
  l0 = self[99]
  if self.Player_Place == 1 then
    l0.SoundId = self.Announcer_FirstPlace[math.random(#self.Announcer_FirstPlace)]
    PushTokenOasisId("[#STRINGA]", "194106") --"1st Place Time:"
  elseif self.Player_Place == 2 then
    l0.SoundId = self.Announcer_NotFirst[math.random(#self.Announcer_NotFirst)]
    PushTokenOasisId("[#STRINGA]", "194107") --"2nd Place Time:"
  elseif self.Player_Place == 3 then
    l0.SoundId = self.Announcer_NotFirst[math.random(#self.Announcer_NotFirst)]
    PushTokenOasisId("[#STRINGA]", "194110") --"3rd Place Time:"
  else
    l0.SoundId = self.Announcer_BadRace[math.random(#self.Announcer_BadRace)]
    PushTokenOasisId("[#STRINGA]", "14331") --"Your Time:"
  end
  PushTokenString("[#STRINGB]", minutes..":"..seconds.."."..decimals)
  SendMissionChannelMessageToLocalPlayersId(Globals._CUSTOM_SCRIPTS._Mission_ID, "PlayerCentric", "15380", 10) --"[#STRINGA] [#STRINGB]"
  --delay final dialog
  l0 = self[45]
  l0.Seconds = 3.0
  l0:Start()
  --stopping custom felony if chased (first part)
  if PlayerFelonyState(GetLocalPlayerEntityId()) == 4 then
    FelonySetHeat(GetLocalPlayerEntityId(), 0)
    FelonyStartChaseObj(GetLocalPlayerEntityId(), self.Index_Faction, "ChaseLevelParameters.178170300", "ChaseLevelParameters.178170300", 1, 1) --ScriptedCop.DriveMission.EscapeIsland.Escaped_searchTimercompleted
  end
end
function export:Play_Dialog()
  local l0
  self = self._graph
  --stopping custom felony if chased (second part)
  if PlayerFelonyState(GetLocalPlayerEntityId()) == 4 then
    FelonySetHeat(GetLocalPlayerEntityId(), 0)
    FelonyForceSearchStart(GetLocalPlayerEntityId())
  end
--disabling spotlight
VehicleLightAndSiren(self.Vehicle_Helicopter, 0, 0, 0, 0, 0, 0, GetInvalidEntityId(), 0, 1)
--executing rewards
ExecuteReward_V2(GetLocalPlayerEntityId(), self.Rewards_XP[self.Player_Place+3-self.Difficulty_Level], 1)
ExecuteReward_V2(GetLocalPlayerEntityId(), self.Rewards_Cash[self.Player_Place+3-self.Difficulty_Level], 1)
--hiding hud
UnregisterVehicleForDamageBarUpdate()
DeliveryHideHud()
  --playing previously set dialogue
  l0 = self[99]
  l0.Supersede = 1
  l0.UseFacial = 0
  l0:Start() --Unload_Layer
end
function export:Unload_Layer()
  local l0
  self = self._graph
self:Finished()
--enabling felony system
FelonySystemEnable(1)
--enabling reputation
EnableReputation(1)
  --removing all vehicles and npcs
  for i=1, #self.List_Opponent_Drivers do
    RemoveEntity(self.List_Opponent_Drivers[i])
    RemoveEntity(self.List_Opponent_Vehicles[i])
  end
  --unloading vanilla layer
  l0 = self[10]
  l0.LayerName = self.Layer_Name
  l0:Unload()
  --unloading custom layer
  l0 = self[1000]
  l0.LayerName = "custom_race"
  l0:Unload()
--terminating mission
Globals._CUSTOM_SCRIPTS._Race[tonumber(string.sub(self.Layer_Name, -2))].Difficulty_Level = 0
AbortMissionWithDbObj(self.Mission_ID)
Globals._CUSTOM_SCRIPTS._Save_Game = 1
end


function export:Check_Place()
  local l0
  self = self._graph
--calculating player distance
self.Player_Distance = GetDistance2D(GetLocalPlayerEntityId(), self.Checkpoint_Selected)
  --calculating opponents distance
  self.Opponents_Distance = {}
  for i=1, #self.List_Opponent_Vehicles do
    if (self.Checkpoint_Indexes[i] < self.Checkpoint_Index and self.Lap_Indexes[i] <= self.Lap_Index) or IsDead(self.List_Opponent_Drivers[i]) == 1 or GetCurrentSeat(self.List_Opponent_Drivers[i]) == 0 or GetVehicleIsDriveable(self.List_Opponent_Vehicles[i]) == 0 then
      table.insert(self.Opponents_Distance, {i, 9999})
    elseif (self.Checkpoint_Indexes[i] > self.Checkpoint_Index and self.Lap_Indexes[i] >= self.Lap_Index) then
      table.insert(self.Opponents_Distance, {i, 0})
    else
      table.insert(self.Opponents_Distance, {i, GetDistance2D(self.List_Opponent_Vehicles[i], self.Checkpoint_Selected)})
    end
  end
  table.sort(self.Opponents_Distance, function(a,b) return a[2] < b[2] end)
  --checking player place
  self.Player_Place = #self.Opponents_Distance+1
  for i=1, #self.Opponents_Distance do
    if self.Player_Distance < self.Opponents_Distance[i][2] then
      self.Player_Place = i
      break
    end
  end
-- ShowMissionTextMessageLocalPlayer("MissionDebug", "DefaultIcon", string.format("%.2f",self.Player_Distance), string.format("%.2f",self.Opponents_Distance[1]).."\n"..string.format("%.2f",self.Opponents_Distance[2]).."\n"..string.format("%.2f",self.Opponents_Distance[3]).."\n"..string.format("%.2f",self.Opponents_Distance[4]).."\n"..string.format("%.2f",self.Opponents_Distance[5]).."\n"..string.format("%.2f",self.Opponents_Distance[6]).."\n"..string.format("%.2f",self.Opponents_Distance[7]), "", "", self.Delay_Position-0.1, 0, self, "OnFinished", "OnDisplayed")
  --displaying new position
self.Loc_Places = { "194114", "194115", "194116", "194111", "194108", "194112", "194109", "194113", }
  l0 = self[20]
  l0.MessageType = "MissionNotification"
  l0.Duration = -1
  l0.Queue = 0
  l0.OasisID_1 = l0.OasisID_1 or {}
  if l0.OasisID_1.id ~= self.Loc_Places[self.Player_Place] then
    l0.OasisID_1.id = self.Loc_Places[self.Player_Place]
    l0:Display()
    --updating reward hud
    UnregisterVehicleForDamageBarUpdate()
    RegisterVehicleForDamageBarUpdate(self.Vehicle_Madness, 0, self.Rewards_Hud[self.Player_Place+3-self.Difficulty_Level], "Vehicle Damage")
  end
  --updating helicopter target
  if self.Player_Place <= 1 then
    self.Place_New = GetLocalPlayerEntityId()
  else
    self.Place_New = self.List_Opponent_Drivers[self.Opponents_Distance[1][1]]
  end
  if self.Helicopter_Enabled == 1 and self.Place_Old ~= self.Place_New then
    self.Place_Old = self.Place_New
    StartHelicopterBhv(self.Vehicle_Helicopter, self.Place_New, self.Place_New, "HelicopterBhvSetup.1179921624") --AggressiveSearch.DriveMission_Follow_normal
    StartHelicopterBhv(self.Vehicle_Helicopter, self.Place_New, self.Place_New, "HelicopterBhvSetup.1179921625") --custom.Race
  end
  --restarting looping timer
  l0 = self[111]
  l0.Seconds = self.Delay_Position
  l0:Start()
end

function export:Check_Opponents()
  local l0
  self = self._graph 
  --hiding markers of unabled opponents and preventing boats sinking
  for i=1, #self.List_Opponent_Drivers do
    if (self.Checkpoint_Indexes[i] > #self.Checkpoints_Data and self.Lap_Indexes[i] >= self.Race_Laps) or IsDead(self.List_Opponent_Drivers[i]) == 1 or GetCurrentSeat(self.List_Opponent_Drivers[i]) == 0 or GetVehicleIsDriveable(self.List_Opponent_Vehicles[i]) == 0 then
      SendMapPointControllerEvent(self.Marker_Enemy[i], 0)
      IndicatorSetIsVisible(GetLocalPlayerId(), self.List_Opponent_Drivers[i], 0)
    end
    if GetDistance3D(GetLocalPlayerEntityId(), self.List_Opponent_Vehicles[i]) > 50 and GetEntityPosition(self.List_Opponent_Vehicles[i], 2) < 58 and IsDead(self.List_Opponent_Drivers[i]) ~= 1 and GetCurrentSeat(self.List_Opponent_Drivers[i]) ~= 0 and GetVehicleIsDriveable(self.List_Opponent_Vehicles[i]) ~= 0 then
      SetEntityPosition(self.List_Opponent_Vehicles[i], GetEntityPosition(self.List_Opponent_Vehicles[i], 0), GetEntityPosition(self.List_Opponent_Vehicles[i], 1), 59)
    end
  end
  --restarting looping timer
  l0 = self[1111]
  l0.Seconds = self.Loop_Delay
  l0:Start()
end
_compilerVersion = 4
