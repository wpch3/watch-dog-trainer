function export:Create(cbox)
  cbox:RegisterGlobals("Domino/User/windycity/custom_scripts/custom_scripts.globals.lua") --loaded global variables
  cbox:RegisterBox("Domino/System/AIGeneratorController.lua")
  cbox:RegisterBox("Domino/System/FelonyChaseMonitor.lua")
  cbox:RegisterBox("Domino/System/FloatingVehicleBhvController.lua")
  cbox:RegisterBox("Domino/System/GetPlayerID.lua")
  cbox:RegisterBox("Domino/System/GridScriptController.lua")
  cbox:RegisterBox("Domino/System/MapPointController_v3.lua")
  cbox:RegisterBox("Domino/System/MissionLayer_v2.lua")
  cbox:RegisterBox("Domino/System/MissionModuleBox_v3.lua")
  cbox:RegisterBox("Domino/System/MissionModuleBoxOnline.lua")
  cbox:RegisterBox("Domino/System/PhoneCallController.lua")
  cbox:RegisterBox("Domino/System/PlayerPostFXController.lua")
  cbox:RegisterBox("Domino/System/PlayDialog_v2.lua")
  cbox:RegisterBox("Domino/System/PlaySound_v2.lua")
  cbox:RegisterBox("Domino/System/ProximityMonitor.lua")
  cbox:RegisterBox("Domino/System/Timer_v2.lua")
  cbox:RegisterBox("Domino/System/VehicleBhvController.lua")
  cbox:RegisterBox("Domino/System/VehicleMonitor_v2.lua")
  cbox:RegisterBox("Domino/System/VehicleSpawnerControl_v2.lua")
  cbox:LoadResource("sndres0x000deac8", "CSoundResource") --checkpoint reached sound
  cbox:LoadResource("sndres0x0010b9ea", "CSoundResource") --music
  cbox:LoadResource("sndres0x0010b9f1", "CSoundResource") --music
  cbox:LoadResource("sndres0x0010b9ec", "CSoundResource") --music
  cbox:LoadResource("sndres0x00024bb7", "CSoundResource") --music
  cbox:LoadResource("sndres0x000fb9a0", "CSoundResource") --music
  cbox:LoadResource("sndres0x000fb99b", "CSoundResource") --music
  cbox:LoadResource("sndres0x000fb996", "CSoundResource") --music chase
  cbox:LoadResource("sndres0x000e9860", "CSoundResource") --"We've got a race coming up, but it's missing something. We think that something could be you."
  cbox:LoadResource("sndres0x000e9ca7", "CSoundResource") --"I know you like to drive and we like to watch you drive, so how about signing up for the next race?"
  cbox:LoadResource("sndres0x000e9663", "CSoundResource") --"We need skilled drivers for an underground race and your name came up ... as usual. Interested?"
  cbox:LoadResource("sndres0x000e9408", "CSoundResource") --"I know you're busy man, but we've got one hell of a race coming up. You in?"
  cbox:LoadResource("sndres0x000e944a", "CSoundResource") --"Up for a challenge? We've got some skilled racers eager to drive against you."
  cbox:LoadResource("sndres0x000e97d8", "CSoundResource") --"Time to show them how it's done. We've got a race coming up and we want to see you school the competition. What do you say?"
  cbox:LoadResource("sndres0x000e9852", "CSoundResource") --"We're putting out a call for talented racers and your name's near the top of the list. You in?"
  cbox:LoadResource("sndres0x000e9c24", "CSoundResource") --"One of your rivals said you'd be too afraid to race him, but we defended you. You want to prove him wrong?"
  cbox:LoadResource("sndres0x000e975e", "CSoundResource") --"We're putting together a high-speed underground race and we need elite drivers. Are you up for it?"
  cbox:LoadResource("sndres0x000e9726", "CSoundResource") --"Thought you'd want to know we've got a big race ready to go soon. You want a piece of the action?"
  cbox:LoadResource("sndres0x000e99af", "CSoundResource") --"Got a chance for you to build your legend. It's a dangerous race. You know the deal. You in?"
  cbox:LoadResource("sndres0x000e9451", "CSoundResource") --"Got a race coming up and there's one prick in particular that I need to lose. With you driving, he's gonna lose. Can you help me?"
  cbox:LoadResource("sndres0x000e99a8", "CSoundResource") --"Just thought you might be interested ... we're setting up an underground run and we need racers who can handle it. Can you handle it?"
  cbox:LoadResource("sndres0x000e9a7f", "CSoundResource") --"We're looking for Chicago's best racers and your name has come up several times. Do you want in?"
  cbox:LoadResource("sndres0x000e940f", "CSoundResource") --"If you're up for a wild underground race, we've got a spot. What do you think?"
  cbox:LoadResource("sndres0x000e94cc", "CSoundResource") --"Still got laps to go in this race."
  cbox:LoadResource("sndres0x000e9aa2", "CSoundResource") --"Multiple laps remain, this is still anybody's race."
  cbox:LoadResource("sndres0x000e991f", "CSoundResource") --"Only just getting started here--we've got more laps ahead."
  cbox:LoadResource("sndres0x000e9c44", "CSoundResource") --"We've still got laps to do, which means it's anybody's guess who will win."
  cbox:LoadResource("sndres0x000e98ae", "CSoundResource") --"You're on the final lap!"
  cbox:LoadResource("sndres0x000e99e4", "CSoundResource") --"Go! This is your final lap!"
  cbox:LoadResource("sndres0x000e9a71", "CSoundResource") --"You're coming into your final lap now."
  cbox:LoadResource("sndres0x000e9710", "CSoundResource") --"This is the final lap. Better move!"
  cbox:LoadResource("sndres0x000e9332", "CSoundResource") --"Somebody just claimed first place. Hurry up!"
  cbox:LoadResource("sndres0x000e97d1", "CSoundResource") --"We've got a winner, who will claim the podium spots?"
  cbox:LoadResource("sndres0x000e99c4", "CSoundResource") --"...and first place is GONE. Who's going to claim second?"
  cbox:LoadResource("sndres0x000e9ac5", "CSoundResource") --"Sorry, but that performance doesn't even rank. Maybe next time."
  cbox:LoadResource("sndres0x000e9460", "CSoundResource") --"Oooh. Don't know what happened there, but that was not your best showing."
  cbox:LoadResource("sndres0x000e9839", "CSoundResource") --"Sorry, but you have to have losers if you're gonna have winners, right?"
  cbox:LoadResource("sndres0x000e9477", "CSoundResource") --"Looks like you got smoked that time. Happens to the best of us."
  cbox:LoadResource("sndres0x000e9a9b", "CSoundResource") --"Almost ... but not quite. A respectable run, though."
  cbox:LoadResource("sndres0x000e98fb", "CSoundResource") --"One of the best drivers out there, but not the best time."
  cbox:LoadResource("sndres0x000e95fa", "CSoundResource") --"I thought for sure you were gonna take it this time. Damn good showing, though."
  cbox:LoadResource("sndres0x000e9569", "CSoundResource") --"You ran a smart race. Well done."
  cbox:LoadResource("sndres0x000e9ca0", "CSoundResource") --"Damn! That was one hell of a run, my friend!"
  cbox:LoadResource("sndres0x000e9b40", "CSoundResource") --"What a race! I don't think anybody was ready for you."
  cbox:LoadResource("sndres0x000e9372", "CSoundResource") --"Jesus Christ, I wish I could drive like that. Well done."
  cbox:LoadResource("sndres0x000e9a15", "CSoundResource") --"You blitzed them, man. They're going to feel that in the morning!"
  cbox:LoadResource("sndres0x000e9c53", "CSoundResource") --"This will be a checkpoint race. A to B. Got it? Good. Shortcuts and dirty tactics are appreciated, but optional."
  cbox:LoadResource("sndres0x000e9bd7", "CSoundResource") --"This will be a circuit race consisting of several laps throughout the city. I suspect your rivals will be trying to cheat, so you may want to do the same."
  cbox:LoadResource("sndres0x000e988b", "CSoundResource") --"This is an anything-goes race to the finish line. We're not concerned about "fair play" or regulations, here - so please be creative."
end
