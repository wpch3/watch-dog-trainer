export = {}
function export:LuaDependencies()
  return {}
end
function export:Create(cbox)
  cbox:RegisterGlobals("Domino/User/windycity/custom_scripts/custom_scripts.globals.lua") --loaded global variables
  cbox:RegisterBox("Domino/System/GetPlayerID.lua")
  cbox:RegisterBox("Domino/System/InteractionScriptMonitor.lua")
  cbox:RegisterBox("Domino/System/MapPointController_v3.lua")
  cbox:RegisterBox("Domino/System/MissionLayer_v2.lua")
  cbox:RegisterBox("Domino/System/PlaySound_v2.lua")
  cbox:RegisterBox("Domino/System/ProximityMonitor.lua")
  cbox:RegisterBox("Domino/System/Timer_v2.lua")
  cbox:LoadResource("sndres0x0012a627", "CSoundResource")
end
function export:Init(cbox)
  self.missionId = cbox:GetParentMissionId()
  local l0
  self[1000] = cbox:CreateBox("Domino/System/MissionLayer_v2.lua")
  l0 = self[1000]
  l0._graph = self
  l0.Loaded = DummyFunction
  l0.Unloaded = DummyFunction
  l0.Reseted = self.Layer_Loaded
  self[5] = cbox:CreateBox("Domino/System/Timer_v2.lua")
  l0 = self[5]
  l0._graph = self
  l0.Out = DummyFunction
  l0.Started = DummyFunction
  l0.Stopped = DummyFunction
  l0.Paused = DummyFunction
  l0.Resumed = DummyFunction
  l0.TimeElapsed = self.Start_Delayed
  l0.LoopingEnded = DummyFunction
  l0.GotTime = DummyFunction
  self[20] = cbox:CreateBox("Domino/System/MapPointController_v3.lua")
  l0 = self[20]
  l0._graph = self
  l0.Shown = DummyFunction
  l0.Hidden = DummyFunction
  l0.TextSet = DummyFunction
  l0.TextHidden = DummyFunction
  self[15] = cbox:CreateBox("Domino/System/ProximityMonitor.lua")
  l0 = self[15]
  l0._graph = self
  l0.Enabled = DummyFunction
  l0.Disabled = DummyFunction
  l0.EnterRadius = self.Radius_Entered
  l0.ExitRadius = self.Radius_Exited
  self[50] = cbox:CreateBox("Domino/System/InteractionScriptMonitor.lua")
  l0 = self[50]
  l0._graph = self
  l0.Out = DummyFunction
  l0.Enabled = DummyFunction
  l0.Disabled = DummyFunction
  l0.OnSuccess = DummyFunction
  l0.OnFail = DummyFunction
  l0.InteractionStarted = self.Trigger_Used
  l0.InteractionFinished = DummyFunction
  l0.AnimationStarted = DummyFunction
  l0.AnimationFinished = DummyFunction
  self[90] = cbox:CreateBox("Domino/System/PlaySound_v2.lua")
  l0 = self[90]
  l0._graph = self
  l0.Out = DummyFunction
  l0.Started = DummyFunction
  l0.Finished = DummyFunction
end
function export:ShutDown()
  local l0
--disabling interaction
SetInteractionScriptState(self.Mission_Trigger, 0)
  --disabling interact monitor
  l0 = self[50]
  l0:Disable()
  --hiding marker
UnBind(self.Mission_Marker)
SetEntityPosition(self.Mission_Marker, GetEntityPosition(self.Mission_Marker, 0), GetEntityPosition(self.Mission_Marker, 1), 1)
  l0 = self[20]
  l0:Hide()
  --disabling marker text radius
  l0 = self[15]
  l0:Disable()
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  ShowMissionTextMessageLocalPlayer("MissionDebug", "DefaultIcon", "WRONG USAGE", "This script is meant to be used as a function.", "", "", 5, 0, self, "OnFinished", "OnDisplayed")
end

function export:Deactivate()
  local l0
--disabling interaction
SetInteractionScriptState(self.Mission_Trigger, 0)
  --disabling interact monitor
  l0 = self[50]
  l0:Disable()
  --hiding marker
UnBind(self.Mission_Marker)
SetEntityPosition(self.Mission_Marker, GetEntityPosition(self.Mission_Marker, 0), GetEntityPosition(self.Mission_Marker, 1), 1)
  l0 = self[20]
  l0:Hide()
  --disabling marker text radius
  l0 = self[15]
  l0:Disable()
self:Deactivated()
end

function export:Activate()
  local l0
  self.Mission_ID = self.Mission_ID or self.missionId
  self.Layer_Name = self.Layer_Name or "custom_Race_activation"
  self.Reference_Entity = self.Reference_Entity or "2584000000000000000"
  self.Mission_Marker = self.Mission_Marker or "2584000000000000000"
  self.Mission_Trigger = self.Mission_Trigger or string.gsub(self.Mission_Marker, "25840000000000000", "25840000000000010", 1)
  self.Mission_Name = self.Mission_Name or "195681" --"Race"
  self.Mission_Type = self.Mission_Type or "194137" --"RACE"
  self.Grid_Position = self.Grid_Position or { GetEntityPosition(GetLocalPlayerEntityId(), 0), GetEntityPosition(GetLocalPlayerEntityId(), 1), GetEntityPosition(GetLocalPlayerEntityId(), 2) }
  self.Position_X = self.Position_X or self.Grid_Position[1]
  self.Position_Y = self.Position_Y or self.Grid_Position[2]
  self.Position_Z = self.Position_Z or self.Grid_Position[3]+1.25
  self.Race_ID = tonumber(string.sub(self.Mission_Marker, -2))
  self.Entry_Fee = self.Entry_Fee or { 100, 750, 1500 }
  --ensuring parameters valid
  if self.Mission_Trigger ~= "2584000000000000100" then
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Check_Activation
    l0:In()
  else
    ShowMissionTextMessageLocalPlayer("MissionDebug", "DefaultIcon", "RACE ACTIVATION FAILED", "Missing or invalid parameters.", "", "", 5, 0, self, "OnFinished", "OnDisplayed")
  end
end
function export:Check_Activation()
  local l0
  self = self._graph
  --calculating race district
  self.Check_Completed = "MissionList.1120090427"
  local Distance_Last = 9999
  for i=1, #Globals._CUSTOM_SCRIPTS._Proximity_Zone do
    if math.sqrt((Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][1]-self.Position_X)^2 + (Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][2]-self.Position_Y)^2) < Distance_Last then
      Distance_Last = math.sqrt((Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][1]-self.Position_X)^2 + (Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][2]-self.Position_Y)^2)
      self.Check_Completed = Globals._CUSTOM_SCRIPTS._Proximity_Zone[i][5]
    end
  end
  --checking race availability
  if type(Globals._CUSTOM_SCRIPTS._Race) ~= "table" then Globals._CUSTOM_SCRIPTS._Race = {} end
  if type(Globals._CUSTOM_SCRIPTS._Race[self.Race_ID]) ~= "table" then Globals._CUSTOM_SCRIPTS._Race[self.Race_ID] = {} end
  if Globals._CUSTOM_SCRIPTS._Races_Enabled ~= 0 and Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level ~= 0 and ((GetEntityName(GetLocalPlayerEntityId()) ~= "player.MainCharacter.PawnPlayer.dlc01_TBone" and IsMissionPlayed(self.Check_Completed) == 1) or (GetEntityName(GetLocalPlayerEntityId()) == "player.MainCharacter.PawnPlayer.dlc01_TBone" and Globals._CUSTOM_SCRIPTS._Force_BadBlood_Compatibility == 1)) then
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Load_Layer
    l0:In()
  end
end
function export:Load_Layer()
  local l0
  self = self._graph
  math.randomseed(Globals._CUSTOM_SCRIPTS._Random_Seed+math.floor(GetGameTime())) --set the global variable as math seed
  math.random(); math.random(); math.random() --pop some random numbers before using them for real
--getting player entity id for next functions
self.PlayerPawn = GetLocalPlayerEntityId()
  --loading layer only if needed
  if GetEntityPosition(self.Reference_Entity, 2) ~= 0 then
    --skipping layer load
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Layer_Loaded
    l0:In()
  else
    --loading the custom layer
    l0 = self[1000]
    l0.LayerName = self.Layer_Name
    l0:Reset() --Layer_Loaded
  end
end
function export:Layer_Loaded()
  local l0
  self = self._graph
  --starting a required delay for subsequent functions
  l0 = self[5]
  l0.Seconds = 1.0
  l0:Start() --Start_Delayed
end
function export:Start_Delayed()
  local l0
  self = self._graph
  --calculating difficulty
  if self.Difficulty_Level == nil then
    if self.Opponents_Amount <= 2 then --if 1vs1 skip easiest
      self.Difficulty_Level = math.random(2,3)
    elseif self.Race_Vehicles == 7 then --if slow boat skip hardest
      self.Difficulty_Level = math.random(1,2)
    elseif self.Race_Vehicles > 3 then --if fast vehicles skip easiest
      self.Difficulty_Level = math.random(2,3)
    elseif self.Race_Vehicles < 3 then --if slow vehicles skip hardest
      self.Difficulty_Level = math.random(1,2)
    else
      self.Difficulty_Level = math.random(1,3)
    end
  end
--saving precalculated data
Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Race_Vehicles = Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Race_Vehicles or self.Race_Vehicles
Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Opponents_Amount = Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Opponents_Amount or self.Opponents_Amount
Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level = Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level or self.Difficulty_Level
  --setting appropriate marker
  if Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level < 2 then
    self.Mission_Marker = string.gsub(self.Mission_Marker, "25840000000000000", "25840000000000001", 1)
  elseif Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level > 2 then
    self.Mission_Marker = string.gsub(self.Mission_Marker, "25840000000000000", "25840000000000003", 1)
  else
    self.Mission_Marker = string.gsub(self.Mission_Marker, "25840000000000000", "25840000000000002", 1)
  end
--setting trigger position
SetEntityPosition(self.Mission_Trigger, self.Position_X, self.Position_Y, self.Position_Z)
--enabling interaction
SetInteractionScriptState(self.Mission_Trigger, 1)
  --enabling interact monitor
  l0 = self[50]
  l0.InteractionScriptEntity = self.Mission_Trigger
  l0.AutoDisable = 0
  l0:Enable() --Trigger_Used
--setting marker position
UnBind(self.Mission_Marker)
SetEntityPosition(self.Mission_Marker, GetEntityPosition(self.Mission_Trigger, 0), GetEntityPosition(self.Mission_Trigger, 1), GetEntityPosition(self.Mission_Trigger, 2))
Bind(self.Mission_Trigger, self.Mission_Marker, "", 1)
  --displaying marker
  l0 = self[20]
  l0.MapPoint = self.Mission_Marker
  l0.LocText = {
    section = "MISSIONS.COMMON.OBJECTIVELABELS",
    item = "Text",
    id = self.Mission_Type
  }
  l0.LocMapMarkerTitle = {
    section = "GPS",
    item = "Title",
    id = self.Mission_Type
  }
  l0.LocMapMarkerDescription = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = self.Mission_Name
  }
  l0:Show()
  --enabling marker text radius
  l0 = self[15]
  l0.Entity1 = GetLocalPlayerEntityId()
  l0.Entity2 = self.Mission_Trigger
  l0.Radius = 3 --matches interact distance
  l0.CheckNow = 1
  l0.CheckDistance3D = 1
  l0:Enable() --Radius_Entered --Radius_Exited
self:Activated()
end
function export:Radius_Entered()
  local l0
  self = self._graph
--enabling interaction
SetInteractionScriptState(self.Mission_Trigger, 1)
--redisplaying marker
SetMapMarkerPopUpDataWithMissionId(self.Mission_Marker, self.Mission_Name, self.Mission_Type, self.Mission_ID) --swapped LocMapMarkerTitle and LocMapMarkerDescription
-- IndicatorSetLocNameId(GetLocalPlayerId(), self.Mission_Marker, self.Mission_Name)
IndicatorSetName(GetLocalPlayerId(), self.Mission_Marker, "Entry fee "..string.format("%d", self.Entry_Fee[Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level]).."$")
end
function export:Radius_Exited()
  local l0
  self = self._graph
--redisplaying marker
SetMapMarkerPopUpDataWithMissionId(self.Mission_Marker, self.Mission_Type, self.Mission_Name, self.Mission_ID) --restored LocMapMarkerTitle and LocMapMarkerDescription
-- IndicatorSetLocNameId(GetLocalPlayerId(), self.Mission_Marker, self.Mission_Type)
IndicatorSetName(GetLocalPlayerId(), self.Mission_Marker, "RACE")
end

function export:Trigger_Used()
  local l0
  self = self._graph
  l0 = self[5]
  l0:Stop()
--disabling interaction
SetInteractionScriptState(self.Mission_Trigger, 0)
  --checking invasion
  if IsInvasionVictim() == 1 or GetNumberOfPlayers() > 1 then
    --disabling interact monitor
    l0 = self[50]
    l0:Disable()
    --disabling marker text radius
    l0 = self[15]
    l0:Disable()
    --setting invasion blocked marker
    SetObjectiveMarkerInvasionState(self.Mission_Marker, 1)
	--playing blocked sound
    l0 = self[90]
    l0.SoundId = "0x0012a627"
    l0:Play()
  elseif GetEntityPosition("2080000000000000002", 1) ~= 0 and Globals._CUSTOM_SCRIPTS._Current_Event ~= 0 and Globals._CUSTOM_SCRIPTS._Gameplay_Context == 2 then
    --disabling interact monitor
    l0 = self[50]
    l0:Disable()
    --disabling marker text radius
    l0 = self[15]
    l0:Disable()
    --setting invasion blocked marker
    SetObjectiveMarkerInvasionState(self.Mission_Marker, 1)
	--playing blocked sound
    l0 = self[90]
    l0.SoundId = "0x0012a627"
    l0:Play()
  elseif GetLocalPlayerCash() < self.Entry_Fee[Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level] then
    --display money warning
    -- IndicatorSetLocNameId(GetLocalPlayerId(), self.Mission_Marker, "40186") --"Not enough cash"
    IndicatorSetName(GetLocalPlayerId(), self.Mission_Marker, "Not enough money")
	--playing blocked sound
    l0 = self[90]
    l0.SoundId = "0x0012a627"
    l0:Play()
  else
    --disabling interact monitor
    l0 = self[50]
    l0:Disable()
    --disabling marker text radius
    l0 = self[15]
    l0:Disable()
    --hiding marker
    UnBind(self.Mission_Marker)
    l0 = self[20]
    l0:Hide()
    --unloading custom layer
    l0 = self[1000]
    l0.LayerName = self.Layer_Name
    l0:Unload()
    --paying fee
    RemoveCash(GetLocalPlayerId(), self.Entry_Fee[Globals._CUSTOM_SCRIPTS._Race[self.Race_ID].Difficulty_Level])
    --starting mission
    StopMissionWithDbObj(self.Mission_ID)
  end
end
_compilerVersion = 4
