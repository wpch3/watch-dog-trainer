  l0.CheckNow = 1
  l0.AutoDisable = 1
  l0:Enable() --Entered_Lobby
  --disabling elevator trigger
  l0 = self[16]
  l0:Disable()
  --enabling server hack
SetHackable("2081393937544645578", 1)
  l0 = self[18]
  l0.HackableEntity = "2081393937544645578"
  l0:Enable()
  --enabling quick descend
  self:ProximityRoofElevator()
  l0 = self[2]
  l0:Enable()
  --enabling roof reenter
  self:ProximityRoofDoor() --Enable_ProximityUnload
  l0 = self[3]
  l0:Enable()
end
