function export:Disable_ProximityEntrance()
  local l0
  self = self._graph
  --checking IF not chased AND not other multiplayer mode AND zone mission layer not loaded AND NOT Alone Madness p30ple Spidertank Bouncing LAYERS
  if FelonyGetType(GetLocalPlayerEntityId()) == 8 and GetNumberOfPlayers() == 1.000000 and GetEntityPosition("2082124800775611431", 2) == 0 and GetEntityPosition("2080711752735150797", 2) == 0 and GetEntityPosition("2082563707426260037", 2) == 0 and GetEntityPosition("2082371120201204534", 2) == 0 and GetEntityPosition("2081694354673681048", 2) == 0 and GetEntityPosition("2080282882919629347", 2) == 0 then
    if Globals._CUSTOM_SCRIPTS._In_Mission == 0 and Globals._CUSTOM_SCRIPTS._Gameplay_Context == 0 then
      Globals._CUSTOM_SCRIPTS._Gameplay_Context = 1
      SetDensityContextOverride("GameplayContextSpec.4012897103") --CUSTOM gameplaycontextspec.lib REQUIRED
      AddScriptNarrativeDelay(9999)
    end
    self:ProximityEntrance()
    l0 = self[1]
    l0:Disable() --Load_A03_M10
SetDoorLockState("2082081014894731931", 0) --exterior doors
SetDoorLockState("2082081016253686429", 0) --exterior doors
  else
    CloseDoor("2082081014894731931", 1) --instant close
    CloseDoor("2082081016253686429", 1) --instant close
    SetDoorLockState("2082081014894731931", 1) --exterior doors
    SetDoorLockState("2082081016253686429", 1) --exterior doors
  end
end
