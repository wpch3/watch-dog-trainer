function export:Count_Down()
  local l0
  self = self._graph
  if Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior == nil or Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior <= 0 then
    l0 = self[40]
    l0:Stop() --Allow_Respawn
  else
    Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior = Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior - 1
  end
end

