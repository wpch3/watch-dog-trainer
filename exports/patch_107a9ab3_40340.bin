    end
  end
  --despawning interior enemies
  if type(self.Spawned_Entrance) == "table" then
    for n=1, #self.Spawned_Entrance do
      RemoveEntity(self.Spawned_Entrance[n])
    end
  end
  l0 = self[65]
  l0.SquadName = "Interior"
  l0:Stop()
  if type(self.Spawned_Enemies) == "table" then
    for n=1, #self.Spawned_Enemies do
      RemoveEntity(self.Spawned_Enemies[n])
    end
  end
  --unloading interior layers
  l0 = self[11]
  l0:UnregisterCallback()
  l0.StandaloneLoader = "2083230033136084819"
  l0.LayerName = ""
  l0:Load()
  l0 = self[12]
  l0.LayerName = "04_ScalabriniGreen_HMA_02"
  l0:Unload()
  l0 = self[13]
  l0.LayerName = "04_ScalabriniGreen_HMA_03"
  l0:Unload()
  l0 = self[10]
  l0.LayerName = "A03_M10"
  l0:Unload() --Enable_ProximityEntrance
end


