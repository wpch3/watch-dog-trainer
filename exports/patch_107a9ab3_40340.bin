function export:Spawn_Enemies()
  local l0
  self = self._graph
  --displaying raid message
  l0 = self[100]
  l0.MessageType = "MissionUpdate"
  l0.MessageIcon = "iconVigilante"
  l0.OasisID_1 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "24738" --"Eliminate all enemies."
  }
  l0.OasisID_3 = {
    section = "MISSIONS.SIDE.OBJECTIVES",
    item = "Description",
    id = "148318" --"RAID"
  }
  l0.Duration = -1
  l0:Display()
  --if exterior not cleared
  if Globals._CUSTOM_SCRIPTS._Respawn_Blocked[10] == 0 then
    self:ProximityExterior() --Respawn_Exterior
    l0 = self[5]
    l0:Enable()
CloseDoor("2082081014894731931", 0) --exterior doors
CloseDoor("2082081016253686429", 0) --exterior doors
    --despawning exterior enemies
