function export:Entered_Lobby()
  local l0
  self = self._graph
SetHackOccludable("2081984359256200674", 0) --elevator button down
SetHackOccludable("2081984359256200685", 0) --elevator button up
SetDoorLockState("2082966043262998703", 0) --guard door
SetDoorLockState("2082264957400915158", 0) --final door
BreakableEntity_NextState("2082969675616248838") --blown up wall
  --playing base video
  l0 = Boxes[PathID("domino/System/MediaSystemCustomBroadcastController.lua")]
  l0.BroadcastInfo = "CustomBroadcasts.932847631"
  l0.OnGenericChannel = 1
  l0.OnShopChannel = 0
  l0.OnBarChannel = 0
  l0.PlayOnLoad = 1
  l0.ApplyOnLoad = nil
  l0._graph = self
  l0.LoadAndPlayRequested = DummyFunction
  l0.EndedAllCustomMediaBroadcasts = DummyFunction
  l0.ActivatedPlayOnBinkChannel = DummyFunction
  l0.AppliedLoadedBufferOnChannels = DummyFunction
  l0.Out = DummyFunction
  l0:LoadAndPlayCustomBroadcast()
  --IF respawn allowed AND no active event
  if (Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior == nil or Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior <= 0) and (GetEntityPosition("2080000000000000002", 1) == 0 or Globals._CUSTOM_SCRIPTS._Current_Event == 0 or Globals._CUSTOM_SCRIPTS._Gameplay_Context ~= 2) then
    Globals._CUSTOM_SCRIPTS._Respawn_Blocked_Rossi_Fremont_Interior = 0
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
-- l0.Out = self.All_Dead --TESTING
-- TeleportEntity(GetLocalPlayerEntityId(), "2082067577231811270", 0, 0) --TESTING
    l0.Out = self.Spawn_Enemies
    l0:In()
  else
    SetDoorLockState("2082067577231811270", 0) --server door
  end
  l0 = self[60]
  l0.MapPoint = self.Stronghold_Marker
  l0:Hide()
end

function export:Respawn_Exterior()
  local l0
  self = self._graph
  self:ProximityExterior()
  l0 = self[5]
  l0:Disable()
  --if exterior not cleared and interior not cleared
  if Globals._CUSTOM_SCRIPTS._Respawn_Blocked[10] == 0 then
    CloseDoor("2082859338596315298", 0) --interior doors
    CloseDoor("2082081047616594647", 0) --interior doors
    --despawning interior enemies
	if type(self.Spawned_Entrance) == "table" then
      for n=1, #self.Spawned_Entrance do
        RemoveEntity(self.Spawned_Entrance[n])
      end
    end
    l0 = self[65]
    l0.SquadName = "Interior"
    l0:Stop()
	if type(self.Spawned_Enemies) == "table" then
      for n=1, #self.Spawned_Enemies do
        RemoveEntity(self.Spawned_Enemies[n])
      end
	end
    --spawning exterior enemies
    self.Exterior_Spawner = CDominoManager_GetInstance():SpawnDominoEntity("Domino/User/windycity/Custom_Scripts/Restricted_Areas/14_thewards_rossifremont.14_thewards_rossifremont_persistent.lua") or GetInvalidEntityId()
    --redisplaying raid marker
    Globals._CUSTOM_SCRIPTS._Notify_Raid = 1
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Allow_Respawn
    l0:In()
  end
  --disabling elevator trigger
  l0 = self[16]
  l0:Disable()
  --reenabling lobby trigger
  l0 = self[14]
  l0.Trigger = "2081337786467770866" --2081348404585327897
  l0.CheckNow = 1
  l0.AutoDisable = 1
  l0:Enable() --Entered_Lobby
end
