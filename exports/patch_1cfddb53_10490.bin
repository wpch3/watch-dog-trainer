TeleportEntity(GetLocalPlayerEntityId(), self.Destination_In, 0, 1)
end

function export:Teleport_Out()
  local l0
  self = self._graph
TeleportEntity(GetLocalPlayerEntityId(), self.Destination_Out, 0, 1)
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Check_Completed_Unload
  l0:In()
end
function export:Check_Completed_Unload()
  local l0
  self = self._graph
  if Globals._CUSTOM_SCRIPTS._In_Mission == 0 and Globals._CUSTOM_SCRIPTS._Gameplay_Context == 1 then
    Globals._CUSTOM_SCRIPTS._Gameplay_Context = 0
    SetDensityContextOverride("") --enabling invasions
  end
HideCameraClippedEntity("2081000000000000048") --Interactive.Interactive_Door.Bar_Door_SportsBar_Front.Locked
HideCameraClippedEntity("2081000000000000051") --Pickup.Ammo.AmmoRefillBox
-- EnableDisplay("Minimap", 1) <- Disabled for The Fox Mod 
-- ResetPlayerMaxLocomotionSpeedTypeOverride(GetLocalPlayerEntityId())
-- ResetCombatAllowedOverride(GetLocalPlayerEntityId())
-- ResetCoverAllowedOverride(GetLocalPlayerEntityId())
-- ResetCoverToCoverAllowedOverride(GetLocalPlayerEntityId())
-- ResetClimbInteractionAllowedOverride(GetLocalPlayerEntityId())
-- ReleaseDominoCameraContext(GetLocalPlayerEntityId(), "CameraBlendListDB.991156136") --Missions.Generic_FAST
  l0 = Boxes[PathID("Domino/System/MissionMonitor.lua")]
  l0.Mission = self.RequiresCompleted
  l0._graph = self
  l0.Completed = self.Unload_Layer
  l0.NotCompleted = DummyFunction
  l0:CheckCompletion()
end
function export:Unload_Layer()
  local l0
  self = self._graph
  l0 = self[5]
  l0:UnregisterCallback()
  l0.StandaloneLoader = self.Standalone_Loader
  l0.LayerName = ""
  l0:Load()
end


function export:Enable_ProximityFarAway()
  local l0
  self = self._graph
  self:ProximityFarAway()
  l0 = self[3000]
  l0:Enable()
end
function export:ProximityFarAway()
  local l0
  l0 = self[3000]
  l0.Entity1 = self.Interior_Marker
  l0.Entity2 = GetLocalPlayerEntityId()
  l0.Radius = 160
  --l0.CheckNow = 1
