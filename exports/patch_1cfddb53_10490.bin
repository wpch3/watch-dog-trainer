export = {}
function export:LuaDependencies()
  return {}
end
function export:Create(cbox)
  cbox:RegisterGlobals("Domino/User/windycity/custom_scripts/custom_scripts.globals.lua") --loaded global variables
  cbox:RegisterBox("Domino/System/GetPlayerID.lua")
  cbox:RegisterBox("Domino/System/InteractionScriptMonitor.lua")
  cbox:RegisterBox("Domino/System/InvasionMonitor.lua")
  cbox:RegisterBox("Domino/System/MapPointController_v3.lua")
  cbox:RegisterBox("Domino/System/MissionLayer_v2.lua")
  cbox:RegisterBox("Domino/System/MissionMonitor.lua")
  cbox:RegisterBox("Domino/System/ProximityMonitor.lua")
  cbox:RegisterBox("Domino/System/StandaloneLoaderController.lua")
end
function export:Init(cbox)
  local l0
  self.Layer_Name = "custom_limbik"
  self.Interior_Marker = "2081000000000000003"
  self.Interaction_ENTER = "2081000000000000010"
  self.Destination_In = "2081000000000000011"
  self.Interaction_EXIT = "2081000000000000012"
  self.Destination_Out = "2081000000000000013"
  self.Standalone_Loader = "2081000000000000054"
  self.PlayerPawn = nil
  self.RequiresCompleted = "MissionList.3079995801" --execute if this completed (available after A04_M03 completion)
  self[0] = cbox:CreateBox("Domino/System/InteractionScriptMonitor.lua") --ENTER
  l0 = self[0]
  l0._graph = self
  l0.Out = DummyFunction
  l0.Enabled = self.Enable_Interaction_EXIT
  l0.Disabled = DummyFunction
  l0.OnSuccess = DummyFunction
  l0.OnFail = DummyFunction
  l0.InteractionStarted = self.Check_Completed
  l0.InteractionFinished = DummyFunction
  l0.AnimationStarted = DummyFunction
  l0.AnimationFinished = DummyFunction
  self[1] = cbox:CreateBox("Domino/System/InteractionScriptMonitor.lua") --EXIT
  l0 = self[1]
  l0._graph = self
  l0.Out = DummyFunction
  l0.Enabled = DummyFunction
  l0.Disabled = DummyFunction
  l0.OnSuccess = DummyFunction
  l0.OnFail = DummyFunction
  l0.InteractionStarted = self.Teleport_Out
  l0.InteractionFinished = DummyFunction
  l0.AnimationStarted = DummyFunction
  l0.AnimationFinished = DummyFunction
  self[5] = cbox:CreateBox("Domino/System/StandaloneLoaderController.lua")
  l0 = self[5]
  l0._graph = self
  l0.LoadingStarted = DummyFunction
  l0.Loaded = self.Teleport_In
  l0.PreviousZoneUnloaded = DummyFunction
  self[1000] = cbox:CreateBox("Domino/System/MissionLayer_v2.lua")
  l0 = self[1000]
  l0._graph = self
  l0.Loaded = DummyFunction
  l0.Unloaded = DummyFunction
  l0.Reseted = self.Loaded_Markers
  self[2000] = cbox:CreateBox("Domino/System/MapPointController_v3.lua")
  l0 = self[2000]
  l0._graph = self
  l0.Shown = DummyFunction --self.Enable_ProximityFarAway NOT NEEDED BECAUSE StandaloneLoaderController BLOCKS FASTTRAVEL ANYWAY
  l0.Hidden = DummyFunction
  l0.TextSet = DummyFunction
  l0.TextHidden = DummyFunction
  self[3000] = cbox:CreateBox("Domino/System/ProximityMonitor.lua")
  l0 = self[3000]
  l0._graph = self
  l0.Enabled = DummyFunction
  l0.Disabled = DummyFunction
  l0.EnterRadius = DummyFunction
  l0.ExitRadius = self.Check_Completed_Unload
  self[4000] = cbox:CreateBox("Domino/System/InvasionMonitor.lua")
  l0 = self[4000]
  l0._graph = self
  l0.CurrentlyIsInvasionVictim = DummyFunction
  l0.NotInvasionVictim = self.Load_Layer
  l0.Out = DummyFunction
end
function export:ShutDown()
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
--self.Entity_Destination = SpawnEntityFromArchetype("{787873A0-B779-459F-93EA-C9654A449448}", -448, -1132, 69, 0, 0, 45)
--TeleportEntity(GetLocalPlayerEntityId(), self.Entity_Destination, 0, 0)
  l0 = self[1000]
  l0.LayerName = self.Layer_Name
  l0:Reset()
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Enable_Interaction_ENTER
  l0:In()
end
function export:Loaded_Markers()
  local l0
  self = self._graph
--TeleportEntity(GetLocalPlayerEntityId(), self.Destination_Out, 0, 0)
HideCameraClippedEntity("2081000000000000048") --Interactive.Interactive_Door.Bar_Door_SportsBar_Front.Locked
