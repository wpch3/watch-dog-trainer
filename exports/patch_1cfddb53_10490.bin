function export:Hide_Marker()
  local l0
  self = self._graph
  l0 = self[2000]
  l0.MapPoint = self.Interior_Marker
  l0:Hide()
SetInteractionScriptState(self.Interaction_ENTER, 0)
SetInteractionScriptState(self.Interaction_EXIT, 0)
end

function export:Enable_Interaction_ENTER()
  local l0
  self = self._graph
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  self.PlayerPawn = l0.PlayerID
  l0 = self[0]
  l0.InteractionScriptEntity = self.Interaction_ENTER
  l0.AutoDisable = 0
  l0:Enable()
end
function export:Enable_Interaction_EXIT()
  local l0
  self = self._graph
  l0 = self[1]
  l0.InteractionScriptEntity = self.Interaction_EXIT
  l0.AutoDisable = 0
  l0:Enable()
end

function export:Check_Completed()
  local l0
  self = self._graph
  l0 = Boxes[PathID("Domino/System/MissionMonitor.lua")]
  l0.Mission = self.RequiresCompleted
  l0._graph = self
  l0.Completed = self.Check_Invasion
  l0.NotCompleted = DummyFunction
  l0:CheckCompletion()
end
function export:Check_Invasion()
  local l0
  self = self._graph
  l0 = self[4000]
  l0:CheckInvasionStatus()
end
function export:Load_Layer()
  local l0
  self = self._graph
  --checking IF not chased AND not other multiplayer mode AND zone mission layer not loaded AND NOT Alone Madness p30ple Spidertank Bouncing LAYERS
  if FelonyGetType(GetLocalPlayerEntityId()) == 8 and GetNumberOfPlayers() == 1.000000 and GetEntityPosition("2082749083256125756", 2) == 0 and GetEntityPosition("2080711752735150797", 2) == 0 and GetEntityPosition("2082563707426260037", 2) == 0 and GetEntityPosition("2082371120201204534", 2) == 0 and GetEntityPosition("2081694354673681048", 2) == 0 and GetEntityPosition("2080282882919629347", 2) == 0 then
    if Globals._CUSTOM_SCRIPTS._In_Mission == 0 and Globals._CUSTOM_SCRIPTS._Gameplay_Context == 0 then
      Globals._CUSTOM_SCRIPTS._Gameplay_Context = 1
      SetDensityContextOverride("GameplayContextSpec.4012897103") --CUSTOM gameplaycontextspec.lib REQUIRED
    end
    l0 = self[5]
    l0:UnregisterCallback()
    l0.StandaloneLoader = self.Standalone_Loader
    l0.LayerName = "02g_vrhack_limbikoffice"
    l0:Load()
  end
end
