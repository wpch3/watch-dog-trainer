HideCameraClippedEntity("2081000000000000050") --Hideouts.Hideout_Ingredients.Sleep_Motel
HideCameraClippedEntity("2081000000000000051") --Pickup.Ammo.AmmoRefillBox
SetPhysicsEnabled("2081000000000000051", 0) --Pickup.Ammo.AmmoRefillBox
-- HideCameraClippedEntity("2081000000000000052") --Pickup.CraftingComponents_Pickup.Electronic
  l0 = Boxes[PathID("Domino/System/MissionMonitor.lua")]
  l0.Mission = self.RequiresCompleted
  l0._graph = self
  l0.Completed = self.Show_Marker
  l0.NotCompleted = self.Hide_Marker
  l0:CheckCompletion()
end
function export:Show_Marker()
  local l0
  self = self._graph
  l0 = self[2000]
