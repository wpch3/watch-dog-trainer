function export:ShutDown()
  for k, v in pairs(self) do
    if type(v) == "table" and v.ShutDown ~= self.ShutDown and v ~= self._graph and v.ShutDown ~= nil then
      v:ShutDown()
    end
  end
end
function export:In()
  local l0
  math.randomseed(Globals._CUSTOM_SCRIPTS._Random_Seed+math.floor(GetGameTime())) --set the global variable as math seed
  math.random(); math.random(); math.random() --pop some random numbers before using them for real
--getting player entity id for next functions
self.PlayerPawn = GetLocalPlayerEntityId()
-- self.Entity_Teleport = SpawnEntityFromArchetype("{787873A0-B779-459F-93EA-C9654A449448}", 1188.1, 1457.6, 62.6, 0, 0, 270)
-- TeleportEntity(GetLocalPlayerEntityId(), self.Entity_Teleport, 0, 0)
  --checking if player respawned
  if Globals._CUSTOM_SCRIPTS._Player_Respawned == GetLocalPlayerEntityId() then
    --loading the custom layer
    l0 = self[1000]
    l0.LayerName = self.Layer_Name
    l0:Reset() --Layer_Loaded
  else
    --unloading the custom layer
    l0 = self[1000]
    l0.LayerName = self.Layer_Name
    l0:Unload() --Layer_Unloaded
  end
end
function export:Layer_Loaded()
  local l0
  self = self._graph
--forcing player exit cover
-- ForceExitCover(GetLocalPlayerEntityId())
--calculating spawn position front right of player character
self.Spawn_X = GetEntityPosition(GetLocalPlayerEntityId(), 0) + 0.1 * math.cos(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 45))
self.Spawn_Y = GetEntityPosition(GetLocalPlayerEntityId(), 1) + 0.1 * math.sin(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 45))
self.Spawn_Z = GetEntityPosition(GetLocalPlayerEntityId(), 2) + 0.1
--collision
SetEntityPosition(self.Turret_NPC, self.Spawn_X, self.Spawn_Y, self.Spawn_Z)
SetEntityAngle(self.Turret_NPC, 0, 0, GetEntityAngle(GetLocalPlayerEntityId(), 2))
RemoveInvincibility(self.Turret_NPC)
ForceHideTagIndicator(self.Turret_NPC, 1)
EnableDialogs(self.Turret_NPC, 1, 1, 1, 1, 0)
DisableTakedownOnPawn(self.Turret_NPC)
SetHackable(self.Turret_NPC, 0)
SetProfilingEnabled(self.Turret_NPC, 0)
HideProfilingPath(self.Turret_NPC)
AssignNPCOverrideConfig(self.Turret_NPC, "NPCOverrideConfig.2696485279") --"Ally.A03_M02_TBone"
SendAICmdBHVstateV2(self.Turret_NPC, "Unaware", "0", 1, 1, 0)
-- AgentDrawWeaponType(self.Turret_NPC, -1)
HideEntity(self.Turret_NPC)
--props
SetEntityPosition(self.Turret_Weapon, GetEntityPosition(self.Turret_NPC, 0) - 0.05 * math.cos(math.rad(GetEntityAngle(self.Turret_NPC, 2) + 90)), GetEntityPosition(self.Turret_NPC, 1) - 0.05 * math.sin(math.rad(GetEntityAngle(self.Turret_NPC, 2) + 90)), GetEntityPosition(self.Turret_NPC, 2) + 1.0575)
SetEntityAngle(self.Turret_Weapon, 0, 0, GetEntityAngle(self.Turret_NPC, 2))
SetPhysicsEnabled(self.Turret_Weapon, 0)
Bind(self.Turret_NPC, self.Turret_Weapon, "", 0)
-- SetEntityPosition(self.Turret_Scope, GetEntityPosition(self.Turret_Weapon, 0) + 0.01 * math.cos(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90.25)), GetEntityPosition(self.Turret_Weapon, 1) + 0.01 * math.sin(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90.25)), GetEntityPosition(self.Turret_Weapon, 2) + 0.3) --Weapons.Accessories.SniperScope
-- SetEntityPosition(self.Turret_Scope, GetEntityPosition(self.Turret_Weapon, 0) - 0.27 * math.cos(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90)), GetEntityPosition(self.Turret_Weapon, 1) - 0.27 * math.sin(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90)), GetEntityPosition(self.Turret_Weapon, 2)+0.01) --GamePlay.Security_Camera_Friendly.Pawnee_Only.NoMove
SetEntityPosition(self.Turret_Scope, GetEntityPosition(self.Turret_Weapon, 0) + 0.12 * math.cos(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90.25)), GetEntityPosition(self.Turret_Weapon, 1) + 0.12 * math.sin(math.rad(GetEntityAngle(GetLocalPlayerEntityId(), 2) + 90.25)), GetEntityPosition(self.Turret_Weapon, 2) + 0.1875) --props.Props.Damien_Camera
SetEntityAngle(self.Turret_Scope, 0, 0, GetEntityAngle(self.Turret_Weapon, 2))
SetPhysicsEnabled(self.Turret_Scope, 0)
Bind(self.Turret_Weapon, self.Turret_Scope, "", 0)
SetEntityPosition(self.Turret_Tripod, GetEntityPosition(self.Turret_NPC, 0), GetEntityPosition(self.Turret_NPC, 1), GetEntityPosition(self.Turret_NPC, 2))
SetEntityAngle(self.Turret_Tripod, 0, 0, GetEntityAngle(self.Turret_NPC, 2)-90)
SetPhysicsEnabled(self.Turret_Tripod, 0)
Bind(self.Turret_NPC, self.Turret_Tripod, "", 0)
--muzzleflash
SetEntityPosition(self.Turret_Muzzleflash, GetEntityPosition(self.Turret_Weapon, 0) + 0.89 * math.cos(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 1) + 0.89 * math.sin(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 2) + 0.11)
SetEntityAngle(self.Turret_Muzzleflash, 0, 0, GetEntityAngle(self.Turret_Weapon, 2))
Bind(self.Turret_Weapon, self.Turret_Muzzleflash, "", 0)
--muzzlesmoke
SetEntityPosition(self.Turret_Muzzlesmoke, GetEntityPosition(self.Turret_Weapon, 0) + 0.99 * math.cos(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 1) + 0.99 * math.sin(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 2) + 0.11)
SetEntityAngle(self.Turret_Muzzlesmoke, 0, 0, GetEntityAngle(self.Turret_Weapon, 2))
Bind(self.Turret_Weapon, self.Turret_Muzzlesmoke, "", 0)
--camera
SetEntityPosition(self.Turret_Camera, GetEntityPosition(self.Turret_Weapon, 0) - 0.025 * math.cos(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 1) - 0.025 * math.sin(math.rad(GetEntityAngle(self.Turret_Weapon, 2) + 90)), GetEntityPosition(self.Turret_Weapon, 2) + 0.275)
SetEntityAngle(self.Turret_Camera, 0, 0, GetEntityAngle(self.Turret_Weapon, 2))
SetPhysicsEnabled(self.Turret_Camera, 0)
Bind(self.Turret_Weapon, self.Turret_Camera, "", 0)
ForceElectricPowerOn(self.Turret_Camera, 1)
SetPowerIngredientOverrideAvailability(self.Turret_Camera, 1)
SetProfilingEnabled(self.Turret_Camera, 1)
--other
Bind(self.Turret_Tripod, self.Turret_RETRIEVE, "", 1)
Bind(self.Turret_Camera, self.Turret_Cooldown, "", 1)
Bind(self.Turret_Camera, self.Turret_Hack, "", 1)
ForceElectricPowerOn(self.Turret_Hack, 1)
SetPowerIngredientOverrideAvailability(self.Turret_Hack, 1)
ForceElectricPowerOn(self.Target_MARK, 1)
SetPowerIngredientOverrideAvailability(self.Target_MARK, 1)
  for i=1, #self.Target_MARKED do
    ForceElectricPowerOn(self.Target_MARKED[i], 1)
    SetPowerIngredientOverrideAvailability(self.Target_MARKED[i], 1)
    ForceElectricPowerOn(self.Target_ELIMINATE[i], 1)
    SetPowerIngredientOverrideAvailability(self.Target_ELIMINATE[i], 1)
  end
  --start monitoring player
  l0 = self[0]
  l0.Pawn = GetLocalPlayerEntityId()
  l0:Enable()
  --starting looping timer to monitor targets
  l0 = self[111]
  l0.Seconds = 0.3
  l0:Start()
  --starting looping timer to detect despawn
  l0 = self[1111]
  l0.Seconds = 0.2
  l0:Start()
  --starting looping timer to detect mission
  l0 = self[11111]
  l0.Seconds = 0.1
  l0:Start()
  --enabling turret health monitor
  l0 = self[10]
  l0.Pawn = self.Turret_NPC
  l0:Enable()
  --enabling camera monitor
  l0 = self[89]
  l0.PlayerEntity = GetLocalPlayerEntityId()
  l0.CameraEntity = self.Turret_Camera
  l0:Enable() --Camera_Entered --Camera_Exiting
  --enabling despawn range
  l0 = self[15]
  l0.Entity1 = GetLocalPlayerEntityId()
  l0.Entity2 = self.Turret_Camera
  l0.Radius = 175
  l0.CheckNow = 0
  l0:Enable() --Despawn_Everything
  --loading the shops layer
  l0 = self[100]
  if GetEntityPosition(self.Turret_Tripod, 0) > 0 and GetEntityPosition(self.Turret_Tripod, 1) < 0 then
    self.Sector_ID = "248000000000001"
    l0.LayerName = self.Layer_Name.."_Shops_1"
  elseif GetEntityPosition(self.Turret_Tripod, 0) < 0 and GetEntityPosition(self.Turret_Tripod, 1) < 0 then
    self.Sector_ID = "248000000000002"
    l0.LayerName = self.Layer_Name.."_Shops_2"
  elseif GetEntityPosition(self.Turret_Tripod, 0) < 0 and GetEntityPosition(self.Turret_Tripod, 1) > 0 then
    self.Sector_ID = "248000000000003"
    l0.LayerName = self.Layer_Name.."_Shops_3"
  else
    self.Sector_ID = "248000000000004"
    l0.LayerName = self.Layer_Name.."_Shops_4"
  end
  l0:Reset() --Shops_Loaded
  -- --activation anim
  -- l0 = self[17]
  -- l0.Seconds = 1/60
  -- l0.Loop = 1
  -- l0.nbLoop = 1.0 * 60
  -- l0:Start() --Turret_Arming --Turret_Armed
-- end
