  --refunding turret item
  if IsAlive(GetLocalPlayerEntityId()) == 1 and GetEntityPosition(self.This_Script, 2) ~= 0 and GetItemCount(GetLocalPlayerEntityId(), self.Item_Power) == 0 then
    ExecuteReward_V2(GetLocalPlayerEntityId(), self.Item_Power, 1)
    --playing sound
    l0 = self[70]
    l0.Entity = GetLocalPlayerEntityId()
    l0.SoundId = "0x0001b16d" --pickup
    l0:Play()
  elseif IsAlive(GetLocalPlayerEntityId()) == 1 and GetEntityPosition(self.This_Script, 2) ~= 0 and GetItemCount(GetLocalPlayerEntityId(), self.Item_Power) > 0 then
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.1125886109", 1) --crafting tech
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.1125886109", 1) --crafting tech
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.3108044763", 1) --system key
    ExecuteReward_V2(GetLocalPlayerEntityId(), "Items.4088031736", 1) --checmical component
    --playing sound
    l0 = self[70]
    l0.Entity = GetLocalPlayerEntityId()
    l0.SoundId = "0x0001b16d" --pickup
    l0:Play()
  end
  --disabling turret
  l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
  l0._graph = self
  l0.Out = self.Turret_Shutdown
  l0:In()
  --stop monitoring player
  l0 = self[0]
  l0:Disable()
  --disabling despawn range
  l0 = self[15]
  l0:Disable()
  --disabling camera monitor
  l0 = self[89]
  l0:Disable()
  --stopping looping timer to detect despawn
  l0 = self[1111]
  l0:Stop()
  --stopping looping timer to detect mission
  l0 = self[11111]
  l0:Stop()
  --unloading the custom layer
  l0 = self[1000]
  l0.LayerName = self.Layer_Name
  l0:Unload() --Layer_Unloaded
end


function export:Check_Targets()
  local l0
  self = self._graph
  --checking targets validity
  for i=#self.Acquired_Targets, 1, -1 do --reverse parsing because chance of table.remove while iterating
    if GetEntityPosition(self.Acquired_Targets[i], 2) == 0 or IsAlive(self.Acquired_Targets[i]) ~= 1 or GetDistance2D(self.Turret_Camera, self.Acquired_Targets[i]) > self.Turret_Range then
	  --removing target from list
      ResetKeyIntel(self.Acquired_Targets[i])
      table.remove(self.Acquired_Targets, i)
      --removing marked hack
      SetHackable(self.Target_MARKED[i], 0)
      table.insert(self.Target_MARKED, table.remove(self.Target_MARKED, i))
      --removing eliminate hack
      SetHackable(self.Target_ELIMINATE[i], 0)
      table.insert(self.Target_ELIMINATE, table.remove(self.Target_ELIMINATE, i))
      --removing target icon
      SendMapPointControllerEvent(self.Target_ICON[i], 0)
      IndicatorSetIsVisible(GetLocalPlayerId(), self.Target_ICON[i], 0)
      table.insert(self.Target_ICON, table.remove(self.Target_ICON, i))
    end
  end
  --restarting looping timer
  l0 = self[111]
  if #self.Acquired_Targets > 0 then
    l0.Seconds = self.Loop_Delay/2
  else
    l0.Seconds = self.Loop_Delay
  end
  l0:Start()
end
function export:Check_Existence()
  local l0
  self = self._graph 
  if GetEntityPosition(self.Turret_Camera, 2) == 0 or IsInvasionVictim() == 1 then
    --entity despawned
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Despawn_Everything
    l0:In()
  else
    --restarting looping timer
    l0 = self[1111]
    l0.Seconds = self.Loop_Delay
    l0:Start()
  end
end
function export:Check_Mission()
  local l0
  self = self._graph
  if self.Mission_Duration == nil or Globals._CUSTOM_SCRIPTS._In_Mission == 0 or Globals._CUSTOM_SCRIPTS._Enable_CompanionItems_InMissions == 1 or GetEntityPosition("2088800000000000000", 2) ~= 0 then --added AMBUSH exception
    self.Mission_Duration = 0
  else
    self.Mission_Duration = self.Mission_Duration + self.Loop_Delay
  end
  if self.Mission_Duration > 5 then
    --ending event
    l0 = Boxes[PathID("Domino/System/GetPlayerID.lua")]
    l0._graph = self
    l0.Out = self.Despawn_Everything
    l0:In()
  else
    --restarting looping timer
    l0 = self[11111]
    l0.Seconds = self.Loop_Delay
    l0:Start()
  end
end


function export:Restore_Item()
  local l0
  self = self._graph
  AddItem(self.Item_Power, 1)
end

function export:Layer_Unloaded()
  local l0
  self = self._graph
  --unloading the shops layers
  l0 = self[100]
  l0:Unload()
  l0.LayerName = self.Layer_Name.."_Shops_1"
  l0:Unload()
  l0.LayerName = self.Layer_Name.."_Shops_2"
  l0:Unload()
  l0.LayerName = self.Layer_Name.."_Shops_3"
  l0:Unload()
  l0.LayerName = self.Layer_Name.."_Shops_4"
  l0:Unload()
--terminating this script and zeroing current event variable
self:ShutDown()
CDominoManager_GetInstance():RemoveDominoEntity(Globals._CUSTOM_SCRIPTS._Launched_Turret)
Globals._CUSTOM_SCRIPTS._Launched_Turret = nil
CDominoManager_GetInstance():RemoveDominoEntity(self.This_Script)
end
