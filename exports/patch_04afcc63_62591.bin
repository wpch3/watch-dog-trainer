SetHackable(self.Turret_Hack, 0)
  l0 = self[88]
  l0.HackableEntity = self.Turret_Hack
  l0:Disable()
  --disabling camera hack
SetHackable(self.Turret_Hack, 0)
SetProfilingEnabled(self.Turret_Hack, 0)
  l0 = self[88]
  l0.HackableEntity = self.Turret_Hack
  l0:Disable()
  --stop follow target
  l0 = self[27]
