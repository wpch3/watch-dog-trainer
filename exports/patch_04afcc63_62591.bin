  l0:Hide()
  --stop killing targets
  l0 = self[28]
  l0:Stop()
  --stop cooldown timer
IndicatorSetIsVisible(GetLocalPlayerId(), self.Turret_Cooldown, 0)
  l0 = self[29]
  l0:Stop()
  --disabling salvage pickup
  l0 = self[50]
  l0:Disable()
  --stopping turret camera effects
  if GetSecurityCameraUser(self.Turret_Camera) == GetLocalPlayerEntityId() then
    StopCameraShake(GetLocalPlayerEntityId(), self.ShakeKey, 0.0)
    StopBinkVideo()
  end
  --stop delayed exit
  l0 = self[99]
  l0:Stop()
  --unloading the shops layer
  l0 = self[100]
  l0:Unload()
end
function export:Despawn_Everything()
