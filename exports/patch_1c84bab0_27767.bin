function export:Entity_Attacked()
  local l0
  self = self._graph
  if Globals._CUSTOM_SCRIPTS._Addons_AmbulanceArrive ~= 0 then
    self.ReticleHitEntity = GetReticleHitEntity()
    if string.find(GetEntityName(self.ReticleHitEntity), "Civilians") then
	  l0 = self[1]
      l0.Pawn = self.ReticleHitEntity
      l0:Enable()
    end
  end
end
function export:NPC_Was_Killed()
  local l0
  self = self._graph
  l0 = self[1]
  l0:Disable()
  self.Chance_Of_Arrival = math.random(1,4)
  if self.Chance_Of_Arrival == 1 and IsInvasionVictim() == 0 and GetNumberOfPlayers() == 1 and self.Event_Status == nil then
	self.Event_Status = "Calling"
	self.NPC = self.ReticleHitEntity
    l0 = self[15]
    l0.Seconds = 0.3
    l0:Start()
	l0 = self[12]
    l0.Seconds = self.Spawn_Delays[math.random(#self.Spawn_Delays)]
    l0:Start()
  end
end
function export:Spawn_Ambulance()
  local l0
  self = self._graph
  self.Event_Status = "Spawning"
  RemoveEntity(Globals._CUSTOM_SCRIPTS._Addons_AmbulanceArrive_DummyEntity)
  Globals._CUSTOM_SCRIPTS._Addons_AmbulanceArrive_DummyEntity = SpawnEntityFromArchetype("{62D838C3-D647-462A-A61C-E1AF780836AE}", GetEntityPosition(GetLocalPlayerEntityId(), 0), GetEntityPosition(GetLocalPlayerEntityId(), 1), GetEntityPosition(GetLocalPlayerEntityId(), 2), 0, 0, 0)
  self.Reference_Entity = Globals._CUSTOM_SCRIPTS._Addons_AmbulanceArrive_DummyEntity or GetInvalidEntityId()
  repeat
    self.Index_Position = math.random(4);self.Index_Position = math.random(4);self.Index_Position = math.random(4)
    self.Player_Angle = GetEntityAngle(GetLocalPlayerEntityId(), 2)
    if self.Player_Angle >= 0 and self.Player_Angle < 90 and self.Index_Position == 4 then
      self.Index_Position = 2
    elseif self.Player_Angle >= 90 and self.Player_Angle < 180 and self.Index_Position == 3 then
      self.Index_Position = 1
    elseif self.Player_Angle >= 180 and self.Player_Angle < 270 and self.Index_Position == 2 then
      self.Index_Position = 4
    elseif self.Player_Angle >= 270 and self.Index_Position == 1 then
      self.Index_Position = 3
    end
    if self.Index_Position == 1 then
      SetEntityPosition(self.Reference_Entity, GetEntityPosition(GetLocalPlayerEntityId(), 0) +65, GetEntityPosition(GetLocalPlayerEntityId(), 1) +65, GetEntityPosition(GetLocalPlayerEntityId(), 2))
    elseif self.Index_Position == 2 then
      SetEntityPosition(self.Reference_Entity, GetEntityPosition(GetLocalPlayerEntityId(), 0) +65, GetEntityPosition(GetLocalPlayerEntityId(), 1) -65, GetEntityPosition(GetLocalPlayerEntityId(), 2))
    elseif self.Index_Position == 3 then
      SetEntityPosition(self.Reference_Entity, GetEntityPosition(GetLocalPlayerEntityId(), 0) -65, GetEntityPosition(GetLocalPlayerEntityId(), 1) -65, GetEntityPosition(GetLocalPlayerEntityId(), 2))
    else
      SetEntityPosition(self.Reference_Entity, GetEntityPosition(GetLocalPlayerEntityId(), 0) -65, GetEntityPosition(GetLocalPlayerEntityId(), 1) +65, GetEntityPosition(GetLocalPlayerEntityId(), 2))
    end
    for i=1, #self.Zone_Entity do
      if GetDistance2D(self.Reference_Entity, self.Zone_Entity[i]) > 0 and GetDistance2D(self.Reference_Entity, self.Zone_Entity[i]) < self.Zone_Safety[i] then
        self.Inside_Zone = 1
        break
      end
      if i == #self.Zone_Entity then
        self.Inside_Zone = 0
      end
    end
    self.Check_Count = self.Check_Count or 0
    self.Check_Count = self.Check_Count + 1
  until self.Inside_Zone ~= 1 or self.Check_Count > 32
  self.Ambulance_Entities = SpawnAIVehicleAndPassengerOnRoad("Ambulance_LivingCity", "EmergentEvent_AmbulanceDriver", self.Reference_Entity, 1)
  self.Ambulance_Vehicle = self.Ambulance_Entities[1]
  self.Ambulance_Driver = self.Ambulance_Entities[2]
  self.Ambulance_Passenger = self.Ambulance_Entities[3]
  RemoveEntity(self.Ambulance_Passenger)
  l0 = self[20]
  l0.Seconds = 0.3
  l0:Start()
  l0 = self[2]
  l0.Seconds = self.Delay
  l0:Start()
end
