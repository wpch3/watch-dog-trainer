  CanBeAttractedBySTP(self.Ambulance_Driver, 0)
  VehicleLightAndSiren(self.Ambulance_Vehicle, 1, 0, 0, 3, 0, 3, GetInvalidEntityId(), 1, 1)
  l0 = self[14]
